{
    "title": "PC keyboard navigation",
    "rules": [
        {
            "description": "Caps Lock or Fn with the arrows is Home, End, Page Up and Page Down, with Alt the document's start and end, as Alt+Home and Alt+End are; a Caps Lock tap is still Compose (PC muscle memory, alongside the setup-macos modifier rotation)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "caps_lock",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "pc_nav_layer",
                                "value": 1
                            }
                        }
                    ],
                    "to_after_key_up": [
                        {
                            "set_variable": {
                                "name": "pc_nav_layer",
                                "value": 0
                            }
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "caps_lock",
                            "hold_down_milliseconds": 200
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "f18",
                        "modifiers": {
                            "optional": [
                                "any"
                            ]
                        }
                    },
                    "to": [
                        {
                            "set_variable": {
                                "name": "pc_nav_layer",
                                "value": 1
                            }
                        }
