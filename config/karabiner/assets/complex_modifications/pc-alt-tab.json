{
    "title": "PC keyboard Alt+Tab",
    "rules": [
        {
            "description": "Alt+Tab switches applications (PC muscle memory, alongside the setup-macos modifier rotation)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_option", "shift"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_control", "shift"]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_option"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_control"]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_control", "shift"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_option", "shift"]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_option"]
                        }
                    ]
                }
            ]
        }
    ]
}
