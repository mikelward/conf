{
    "title": "PC keyboard Ctrl+Tab",
    "rules": [
        {
            "description": "Ctrl+Tab goes to the next tab, not the application switcher (PC muscle memory, alongside the setup-macos modifier rotation; Alt+Tab is tilemo's)",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_control", "shift"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_option", "shift"]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "tab",
                        "modifiers": {
                            "mandatory": ["left_control"]
                        }
                    },
                    "to": [
                        {
                            "key_code": "tab",
                            "modifiers": ["left_option"]
                        }
                    ]
                }
            ]
        }
    ]
}
