# Environment for mesh (https://github.com/mikelward/mesh), read on every
# invocation -- interactive, script, `-c`, and piped input alike.
#
# This is the environment half of the shrc port; config/mesh/rc.mesh is the
# interactive half. mesh reads env.mesh first and always, so anything a
# non-interactive `mesh script.mesh` needs -- PATH, EDITOR, PAGER -- lives
# here, and rc.mesh may rely on the helpers this file defines.
#
# Kept in parity with shrc (bash/zsh), config/fish/config.fish, and
# config/nushell/config.nu.
#
# Mikel Ward <mikel@mikelward.com>

###############
# FAILSAFE
# Cross-shell escape hatch. Mirrors shrc's FAILSAFE check and the
# equivalents in config.fish and config.nu: bail out before touching PATH or
# the environment, so a misbehaving rc is recoverable with `FAILSAFE=1 mesh`.
# LC_FAILSAFE is accepted as an alias so the flag survives sshd's env
# sanitization (most sshd configs AcceptEnv LC_*). ~/.failsafe is the
# persistent opt-in: `touch ~/.failsafe` keeps every new shell in failsafe
# mode without re-setting the variable.
#
# `:bool` reads 1/true as on and 0/false as off, and reports anything else on
# stderr rather than reading it as off in silence -- the other three configs
# hand-roll the same rule, since only mesh has the modifier.
#
# Defined as a function as well as used here so rc.mesh can ask the same
# question rather than restating the rule.
func failsafe-wanted() {
  if $env:get(FAILSAFE, false):bool { return true }
  if $env:get(LC_FAILSAFE, false):bool { return true }
  if "$env.HOME/.failsafe":exists { return true }
  return false
}

if failsafe-wanted() {
  puts "failsafe mode" >&2
  return
}

#################
# BASIC HELPERS
# Small predicates the rest of this file and rc.mesh are written in terms of.
# mesh owns `puts`, `print`, and `gets` as builtins, so only the stderr twins
# need defining.
#
# Each one taking a `...rest` is a `wrapper func`: none declares a flag, and a
# plain `func` scans every `--`-leading argument against its signature -- so
# `warn "--x is unset"` and `quiet somecmd --flag` would both be rejected for a
# flag that is really data or belongs to the delegated command.

# print an important message that's not quite an error
wrapper func warn(...args) { puts ...$args >&2 }

# print an error message
wrapper func error(...args) { puts ...$args >&2 }

# return true if the argument exists as a command on PATH, ignoring builtins
# and functions. `type -P` is the PATH-only lookup, which is what shrc's
# have_command/path pair hand-rolls with a loop over $PATH.
func have-command(name) {
  if type -P --quiet $name { return true }
  return false
}

# print the full path to an executable, ignoring builtins and functions
func path(name) { type -P $name }

# return true if the argument is runnable at all -- keyword, builtin,
# function, or command
func is-runnable(name) {
  if type --quiet $name { return true }
  return false
}

# return true if the argument is a function
func is-function(name) {
  if $(type -t $name 2> /dev/null) == function { return true }
  return false
}

# run a command with its output silenced
wrapper func quiet(cmd, ...args) { $cmd ...$args > /dev/null 2> /dev/null }

# return true if the name is one mesh owns and so cannot be defined as a
# function. `type -t` separates the two flavors from everything else: `keyword`
# is a built-in value call (`files`, `re`, `style`, `glob`, `link`, `dirs`),
# which is a *syntax* error to define and therefore costs a whole file; and
# `builtin` is a reserved word (`puts`, `command`, `source`, `exit`), which is a
# runtime error costing only itself. `file` -- an ordinary program -- is
# deliberately not included: shadowing one is allowed.
#
# Asked of mesh rather than compared against a list written out here, so it
# stays right as mesh grows its keywords and builtins.
func is-shell-name(name) {
  kind = $(type -t $name 2> /dev/null)
  if $kind == keyword { return true }
  if $kind == builtin { return true }
  return false
}

# return true if the string starts with the given prefix. `~` takes a bare
# glob or a regex, never a string, so a computed prefix is tested by seeing
# whether stripping it changed anything.
#
# A wrapper because the arguments are *data*: a value call scans an argument
# whose runtime value begins with `--` as a flag, so asking
# `starts-with($arg, "--sleep=")` about a `--sleep=0` reported
# `starts-with: unknown flag --sleep`. Nothing here takes flags of its own.
wrapper func starts-with(text, prefix) {
  return false if $prefix == ""
  return $text:replacestart($prefix, "") != $text
}

# drop every occurrence of $entry from $list, used to rebuild MANPATH/INFOPATH
# without growing them on a reload.
#
# Empty elements are *kept*: an empty component in a man/info path means "and
# the system defaults here", so an inherited `INFOPATH=/custom:` would lose the
# system Info directories if the empty went with it.
wrapper func without(list, entry) {
  out = []
  for item in $list {
    continue if $item == $entry
    out += [$item]
  }
  return $out
}

# drop one trailing empty element. MANPATH always ends in one, so the inherited
# copy is removed before a fresh one is appended -- otherwise a reload would
# leave two, then three.
wrapper func drop-trailing-empty(list) {
  return $list if $list:len == 0
  return $list:init if $list:last == ""
  return $list
}

####################
# STANDARD VARIABLES
# The bash-like variables everything assumes are preset. Each is only
# computed when it isn't already in the environment, so a shell started from
# one of these pays no fork for it.

if $env:get(USERNAME, "") == "" { export USERNAME = $(id -un) }
if $env:get(HOSTNAME, "") == "" { export HOSTNAME = $(hostname -f) }
# `$sh.uid` rather than a fork of `id -u`: this is the one of the three mesh
# can answer itself, and it runs on every startup that did not inherit a UID.
if $env:get(UID, "") == "" { export UID = $sh.uid }
# `tty` prints "not a tty" on *stdout* and exits 1 when stdin isn't a terminal,
# so the name is bound only when the capture succeeded -- exporting the
# diagnostic would put "not a tty" into every child's TTY, and into every
# log-history line. Matches config.nu's `try { tty } catch { "" }`.
#
# Recomputed rather than inherited, unlike the three above: TTY is the one that
# differs per terminal, and plenty of things put it in the environment -- zsh
# fills and exports it before any rc runs, and config.nu, rc.elv and this file
# export their own. A long-lived process started from one shell therefore hands
# that terminal's pty to everything it later spawns, and shpool's daemon is
# exactly that: every session it opens inherited the pty of whichever terminal
# first started the daemon, so log-history filed every command against the wrong
# terminal and publish-jobs wrote over another terminal's job file. config.fish
# and config.nu already compute it unconditionally.
if name = $(tty) { export TTY = $name } else { export TTY = "" }

#######
# PATH FUNCTIONS
# mesh reads $env.PATH as a real list, so these are list operations rather
# than the string surgery shrc needs.

# remove $dir from $env.PATH
func delete-path(dir) {
  kept = []
  for d in $env.PATH {
    if $d != $dir { kept += [$d] }
  }
  $env.PATH = $kept
}

# return true if $dir is already on $env.PATH
func inpath(dir) {
  return $env.PATH:has($dir)
}

# add $dir to the front of $env.PATH, if it exists
#
# `:prepend` puts it on the front and `:dedup` drops the later copies, which is
# the move-to-front `delete-path` used to spell in two statements. `:dedup`
# keeps the *first* occurrence, so the one just added is the one that survives.
#
# Any duplicate the inherited PATH already carried is collapsed too. That is
# deliberate, and it is the one place the mesh config is *ahead* of shrc, fish,
# nushell and Elvish rather than in parity with them: they delete only the entry
# being moved, so a duplicate inherited from elsewhere outlives a reload there.
# Normalizing the whole list is welcome on something every command lookup walks.
func prepend-path(dir) {
  return unless $dir:d
  $env.PATH = $env.PATH:prepend($dir):dedup
}

# add $dir to the end of $env.PATH, if it exists
#
# The delete stays here, where `prepend-path` sheds it: `:dedup` keeps the first
# occurrence, so an entry already on the front would win over the copy being
# appended and the dir would not move to the end at all.
func append-path(dir) {
  return unless $dir:d
  delete-path $dir
  $env.PATH = $env.PATH:append($dir)
}

# add $dir to $env.PATH at the given position: `start`, `end`, or -- with no
# position -- append only when it isn't there already
func add-path(dir, where = "") {
  match $where {
    start => { prepend-path $dir }
    end   => { append-path $dir }
    _     => {
      if inpath($dir) { return }
      append-path $dir
    }
  }
}

##################################
# ENVIRONMENT SETUP
# The dir list mirrors ~/.env (which POSIX shells source) and config.fish;
# mesh cannot source a POSIX file, so the list is spelled out here the way
# fish spells it out.
#
# The ordering is shrc's, and it matters: this block is the analogue of
# ~/.env's PATH line, so it runs *before* the local override below, which is
# the analogue of ~/.env.local. Each `start` puts its dir in front of the ones
# already there, so whatever the local file prepends ends up ahead of all of
# these -- the precedence a per-machine override is for.

add-path /usr/local/bin start
add-path ~/android-sdk-linux/platform-tools start
add-path ~/android-studio/bin start
add-path ~/Android/Sdk/platform-tools start
add-path ~/depot_tools start
add-path ~/google-cloud-sdk/bin start
add-path ~/.local/bin start
add-path ~/.cargo/bin start
add-path ~/bin start
add-path ~/scripts start
add-path /sbin end
add-path /usr/sbin end

##################################
# LOCAL ENVIRONMENT OVERRIDES
# Read after the standard list, so a `add-path /custom/bin start` here lands in
# front of it -- shrc gets the same precedence by sourcing ~/.env.local
# immediately after ~/.env -- and before everything that reacts to it: the
# GOPATH default below, the glob-only PATH additions, and, because env.mesh
# runs before rc.mesh, the session-manager gating (WANT_SHPOOL, WANT_TMUX,
# SESSION_BACKEND) that decides whether this shell hands off at all.
# rc.local.mesh is too late for those, since the handoff happens before it is
# read.
#
# This is mesh's answer to shrc's ~/.env.local. POSIX shells source ~/.env and
# ~/.env.local from zshenv/profile and export the result, so fish and nushell
# inherit those values rather than reading the files; a mesh started as a login
# shell has no such parent, which is why it needs a file of its own. The PATH
# functions above are already defined, so this file may call add-path.
if "$env.HOME/.config/mesh/env.local.mesh":read {
  source "$env.HOME/.config/mesh/env.local.mesh"
  # Reported here rather than left to whoever sourced env.mesh: a file's status
  # is that of its *last* statement, so every assignment below would overwrite
  # this one and `rerc`'s guard would see success over a half-applied local
  # config.
  #
  # Reported but not fatal, deliberately. This file is per-machine setup, so a
  # broken one must not also cost the standard PATH, GOPATH and brew/fnm setup
  # below it -- a login shell with no PATH at all is worse than one whose local
  # overrides only half-applied, and there may be no other shell to repair it
  # from. shrc's `.` of ~/.env.local carries on the same way.
  if $sh.status != 0 {
    warn "env.local.mesh failed; the rest of the environment is still being set up"
  }
}

# keep an inherited GOPATH (e.g. from a parent that read ~/.env, or set in
# env.local.mesh just above) rather than clobbering it; an empty one still gets
# the default, matching shrc's ${GOPATH:-$HOME}
# `cd Downloads` from anywhere. Set here rather than in rc.mesh because a
# non-interactive `mesh script.mesh` resolves `cd` the same way, and because a
# mesh started as a login shell has no POSIX parent to inherit it from. mesh
# reads CDPATH as a list, like PATH, so it is written as one rather than as
# shrc:1183's `.:$HOME` string.
$env.CDPATH = ["." "$env.HOME"]

if $env:get(GOPATH, "") == "" { export GOPATH = $env.HOME }

# $GOPATH/bin is ~/bin already when GOPATH is the default, and prepending it
# unconditionally would reorder ~/bin in front of ~/scripts; only add it when
# env.local.mesh moved GOPATH elsewhere. shrc:1193 guards it the same way.
if $env.GOPATH != $env.HOME { add-path "$env.GOPATH/bin" start }

# The globs go last, after the local file, exactly as in shrc: they can't be
# written as a plain list, and scripts.home / scripts.work override scripts.
for dir in ~/scripts.* { add-path $dir start }
for dir in /opt/*/bin { add-path $dir end }

#####################
# SHELL-ENV GENERATORS
# brew and fnm publish their environment as a shell snippet meant for `eval`.
# mesh has neither `eval` nor a dynamically-named environment write
# (`$env[$name] = value` is a syntax error), so a generic "read KEY=VALUE and
# apply it" helper -- shrc's eval_tool_init, fish's `| source` -- cannot be
# written here. Both tools are therefore handled by name instead: brew's
# snippet is a fixed set of assignments derived from its prefix, and fnm's is
# parsed into the variables fnm is documented to set.

# Take the leading quoted run of a shell word, or the whole word when it isn't
# quoted. `fnm env` writes PATH as `"/…/bin":$PATH` -- the closing quote is in
# the middle, not at the end -- so trimming quotes off both ends would leave a
# stray one behind. Splitting on the quote character gives the quoted run as
# the second field either way.
func unquoted-head(value) {
  return $value:split("\"")[1] if starts-with($value, "\"")
  return $value:split("'")[1] if starts-with($value, "'")
  return $value
}

# Split one `export KEY="VALUE"` line into [name value], or the empty list when
# it isn't an assignment. A trailing `;` is dropped and the value is unquoted.
#
# No shell expansion is performed: a value carrying a `$` reference is reported
# and skipped rather than exported with the reference still in it. The callers
# handle the one variable that needs splicing -- PATH -- by name, since mesh
# holds it as a list rather than a string.
func shellenv-entry(line) {
  entry = $line:trimstart:trimend
  return [] if $entry == ""
  return [] if $entry ~ /^#/
  entry = $entry:replacestart("export ", "")
  entry = $entry:replaceend(";", "")
  return [] if $entry !~ /^[A-Za-z_][A-Za-z0-9_]*=/
  name = $entry:split("=")[0]
  value = unquoted-head($entry:replacestart("$name=", ""))
  return [$name $value]
}

# brew is often off-PATH (Linuxbrew's prefix isn't on the default PATH), so
# fall back to known locations; $BREW overrides the search (tests). Rather
# than eval'ing `brew shellenv`, derive the same variables from the prefix --
# which is all that snippet does.
func setup-brew() {
  brew-bin = ""
  if have-command(brew) {
    brew-bin = $(type -P brew)
  } else {
    for candidate in [$env:get(BREW, "") /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$env.HOME/.linuxbrew/bin/brew"] {
      if $candidate != "" and $candidate:x {
        brew-bin = $candidate
        break
      }
    }
  }
  return if $brew-bin == ""
  # `<prefix>/bin/brew` is the layout every real install has, so the prefix is
  # the grandparent -- and it must *not* be resolved through symlinks, since
  # `bin/brew` points into `$prefix/Homebrew` on Linuxbrew and Intel macOS and
  # following it would name the repo as the prefix.
  #
  # That derivation is wrong only when brew was reached through a shim outside
  # its own tree (`~/bin/brew` -> the real one), where the grandparent is
  # `$HOME`. `$prefix/Cellar` is what tells the two apart -- Homebrew creates it
  # at install time -- and only then is brew asked, so the usual case still pays
  # no fork where shrc's `eval "$(brew shellenv)"` pays one every time.
  prefix = $brew-bin:dir:dir
  if not "$prefix/Cellar":d {
    answer = $($brew-bin --prefix 2> /dev/null)
    # Nothing usable to fall back to: the derived prefix is already known wrong
    # (that is what brought us here), so publishing it would export bogus
    # HOMEBREW_* and prepend bin/sbin from an unrelated tree. Say so and leave
    # brew unconfigured, which at least keeps PATH honest.
    if $answer == "" {
      warn "brew: cannot determine the install prefix; brew is not set up"
      fail
    }
    prefix = $answer:trimend
  }
  export HOMEBREW_PREFIX = $prefix
  export HOMEBREW_CELLAR = "$prefix/Cellar"
  # The Homebrew git repo is at $prefix/Homebrew under Linuxbrew and Intel
  # macOS, and at the prefix itself on Apple silicon; pick whichever is there,
  # as config/nushell/config.nu does.
  repo = "$prefix/Homebrew"
  if $repo:d {
    export HOMEBREW_REPOSITORY = $repo
  } else {
    export HOMEBREW_REPOSITORY = $prefix
  }
  prepend-path "$prefix/sbin"
  prepend-path "$prefix/bin"
  # Reading an unset $env.NAME is an error, so the existing value is fetched
  # through `:get` with an empty list rather than named directly. The trailing
  # empty component is `brew shellenv`'s, and keeps the system man directories
  # searchable: MANPATH always ends in one, INFOPATH only when it was unset.
  #
  # Both are rebuilt idempotently, because `rerc` re-reads this file: a plain
  # prepend would put the same brew dir on the front again on every reload and
  # grow the list without bound, the way `add-path` avoids for PATH by deleting
  # first. The entry being added and any interior empties are dropped from the
  # inherited value; the single trailing empty is re-added below rather than
  # kept, so reloading cannot accumulate those either.
  man-dir = "$prefix/share/man"
  man-path = drop-trailing-empty(without($env:get(MANPATH, []), $man-dir))
  $env.MANPATH = ["$man-dir" ...$man-path ""]
  info-dir = "$prefix/share/info"
  info-path = without($env:get(INFOPATH, []), $info-dir)
  if $info-path:len == 0 {
    $env.INFOPATH = ["$info-dir" ""]
  } else {
    $env.INFOPATH = ["$info-dir" ...$info-path]
  }
}

# fnm (Fast Node Manager): put its dir on PATH, then apply the node shims and
# FNM_* variables `fnm env` publishes. The default install dir mirrors fnm's
# own installer (legacy ~/.fnm, else $XDG_DATA_HOME/fnm, else the macOS
# Application Support dir, else ~/.local/share/fnm); FNM_PATH overrides all of
# it. The standalone installer drops the binary in that dir; a
# Homebrew/Cargo/release install puts fnm elsewhere on PATH and treats this
# only as the data dir, which `fnm env` creates on demand -- so the env call
# isn't gated on the dir existing.
func setup-fnm() {
  fnm-path = ""
  if $env:get(FNM_PATH, "") != "" {
    fnm-path = $env.FNM_PATH
  } else if "$env.HOME/.fnm":d {
    fnm-path = "$env.HOME/.fnm"
  } else if $env:get(XDG_DATA_HOME, "") != "" {
    fnm-path = "$env.XDG_DATA_HOME/fnm"
  } else if $(uname -s) == Darwin {
    fnm-path = "$env.HOME/Library/Application Support/fnm"
  } else {
    fnm-path = "$env.HOME/.local/share/fnm"
  }
  if $fnm-path:d { add-path $fnm-path start }
  return unless have-command(fnm)
  # `fnm env` speaks bash/zsh/fish; bash's `export KEY="VALUE"` is the shape
  # shellenv-entry reads. Each name is assigned explicitly because mesh has no
  # dynamically-named environment write; an unrecognized one is reported
  # rather than dropped, so a new fnm variable shows up as a warning instead
  # of a silently missing shim.
  # `fnm env` mints a fresh multishell directory per invocation, so the shim
  # this shell is already using has to be remembered before the loop below
  # overwrites FNM_MULTISHELL_PATH: `rerc` would otherwise only ever delete
  # the *new* shim from PATH, leaving every previous one behind.
  old-shim = $env:get(FNM_MULTISHELL_PATH, "")
  # Captured and checked rather than iterated inline. A failing `fnm env` --
  # an inaccessible state dir, say -- yields no assignments, and the code below
  # would then re-prepend the *previous* shim, deliberately putting a stale
  # node back at the front of PATH on every reload. Better to say so and leave
  # PATH alone.
  env-output = $(fnm env --shell bash)
  if $sh.status != 0 {
    warn "fnm: could not read the node environment; node shims are unchanged"
    fail
  }
  for line in $env-output:split("\n") {
    entry = shellenv-entry($line)
    continue if $entry:len == 0
    name = $entry[0]
    value = $entry[1]
    match $name {
      # fnm's PATH line is skipped: it writes `"<shim>":$PATH`, which would
      # need shell expansion to apply, and the shim is $FNM_MULTISHELL_PATH/bin
      # anyway. It goes on the front of mesh's list PATH below, as
      # config/nushell/config.nu does.
      PATH => { }
      FNM_MULTISHELL_PATH => { export FNM_MULTISHELL_PATH = $value }
      FNM_DIR => { export FNM_DIR = $value }
      FNM_LOGLEVEL => { export FNM_LOGLEVEL = $value }
      FNM_NODE_DIST_MIRROR => { export FNM_NODE_DIST_MIRROR = $value }
      FNM_COREPACK_ENABLED => { export FNM_COREPACK_ENABLED = $value }
      FNM_RESOLVE_ENGINES => { export FNM_RESOLVE_ENGINES = $value }
      FNM_ARCH => { export FNM_ARCH = $value }
      FNM_VERSION_FILE_STRATEGY => { export FNM_VERSION_FILE_STRATEGY = $value }
      _ => { warn "fnm: $name is not one this shell knows how to set; node may be missing a setting" }
    }
  }
  # The shim dir holds the node/npm/npx symlinks for the selected version, and
  # has to lead PATH. It is created by the `fnm env` call above, so prepend it
  # directly rather than through add-path, whose does-it-exist test would have
  # dropped it on the first run of a shell.
  shim = $env:get(FNM_MULTISHELL_PATH, "")
  delete-path "$old-shim/bin" if $old-shim != "" and $old-shim != $shim
  return if $shim == ""
  delete-path "$shim/bin"
  $env.PATH = ["$shim/bin" ...$env.PATH]
}

setup-brew
setup-fnm

##################
# PROGRAM DEFAULTS

# set HISTORY_FILE for log-history
export HISTORY_FILE = "$env.HOME/.history"

export LESS = "-R"
if "$env.HOME/scripts/lessopen":exists {
  export LESSOPEN = "|$env.HOME/scripts/lessopen \"%s\""
}

# readline and editline configuration for the children that use them; mesh's
# own line editor reads neither.
if "$env.HOME/.inputrc":read { export INPUTRC = "$env.HOME/.inputrc" }
if "$env.HOME/.editrc":read { export EDITRC = "$env.HOME/.editrc" }

# default programs, in preference order -- the last one that exists wins.
# kitty wants EDITOR set even for non-interactive shells.
if is-runnable(vi) { export EDITOR = vi }
if is-runnable(vim) { export EDITOR = vim }
if is-runnable(editline) { export EDITOR = editline }
if is-runnable(more) { export PAGER = more }
if is-runnable(less) { export PAGER = less }
if is-runnable(meld) and $env:get(DISPLAY, "") != "" { export DIFF = meld }

export BLOCKSIZE = 1024
export CLICOLOR = true
export GREP_COLOR = 4          # BSD grep and older GNU grep - underline matches
export GREP_COLORS = "mt=4"    # GNU grep - underline matches

# colors for ls
match $env:get(TERM, "") {
  linux | putty | vt220 => {
    # colors for white on black
    export LSCOLORS = "ExFxxxxxCxxxxx"
    export LS_COLORS = "no=00:fi=00:di=01;34:ln=01;35:so=00;00:bd=00;00:cd=00;00:or=01;31:pi=00;00:ex=01;32"
  }
  _ => {
    # colors for black on white
    export LSCOLORS = "exfxxxxxcxxxxx"
    export LS_COLORS = "no=00:fi=00:di=00;34:ln=00;35:so=00;00:bd=00;00:cd=00;00:or=00;31:pi=00;00:ex=00;32"
  }
}
