# Interactive configuration for mesh (https://github.com/mikelward/mesh).
#
# This is the interactive half of the shrc port; config/mesh/env.mesh is the
# environment half and mesh always reads it first, so the helpers it defines
# (warn, error, have-command, is-runnable, path, quiet, add-path) are in scope
# here.
#
# Things that are intrinsically bash/zsh-specific -- readline and zle keymaps,
# the DEBUG trap, `alias`, bracketed-paste escapes, per-package completion
# scripts -- are mesh's own job and are not ported: mesh ships emacs line
# editing, prompt hooks, and completions it works out for itself.
#
# Kept in parity with shrc (bash/zsh), config/fish/config.fish, and
# config/nushell/config.nu.
#
# Mikel Ward <mikel@mikelward.com>

###############
# FAILSAFE
# Same escape hatch as env.mesh, restated because rc.mesh has to stand on its
# own: env.mesh returns before defining want-failsafe only when failsafe is
# already on, but a shell started with --norc-style surgery, or a checkout
# with only rc.mesh linked, must still bail cleanly.
if $env:get(FAILSAFE, false):bool or $env:get(LC_FAILSAFE, false):bool or "$env.HOME/.failsafe":exists {
  puts "failsafe mode" >&2
  prompt "$ "
  return
}

#################
# BASIC HELPERS
#
# One rule holds across this file and env.mesh: **nothing here declares a flag
# of its own, so anything taking a `...rest` is a `wrapper func`.** A plain
# `func` scans every `--`-leading argument against its signature, which breaks
# both kinds of rest parameter -- one holding a delegated command's options
# (`setx curl --location URL`) and one holding data that merely looks like an
# option (`bak --weird-name`, `error "--x is unset"`). The three helpers that
# do take an option of their own -- retry, body, recent -- read it off the
# front by hand, because a declared flag would be matched anywhere in the list.
#
# A second rule, from mesh's return types: **a function that answers with a
# value declares that value's type, and one that only acts declares nothing.**
# An undeclared `func` has no value channel at all -- `x = f()` binds its
# status, whatever the body produced -- so the declaration is what makes
# `tilde-pwd()` a path rather than a `0`. The split falls out of what each one
# is for: `str func host-info()` builds a string for the prompt to place,
# `func preprompt()` draws one and answers nothing.
#
# Nothing here declares `any`, and that is a result rather than a rule. Where a
# function looked two-typed it turned out to be answering one thing and
# reporting another: `age` yields an int and *fails* for a file it cannot read
# (`fail`, not a returned status, so a hit stays usable as a condition), and the
# availability pair converts `have-command`'s status at the boundary rather than
# passing it through. Both are worth the line they cost -- a type that says
# `any` tells a caller nothing it did not already have to find out by reading.

# ask the user whether to do something; true on yes or a bare Enter
#
# The prompt goes to stderr: it is UI rather than output, so `confirm x > log`
# still asks, and a caller reading stdout gets only what it asked for. bash's
# own `read -p` prompts on stderr for the same reason.
#
# `gets()` -- the value form -- rather than the `gets reply` command form,
# because the command form leaves `reply` *unchanged* at end of input, and there
# is nothing there to leave it as: `confirm x < /dev/null` died on an unbound
# variable instead of answering. The value form yields `false` there, which
# falls through the match to a decline, as rc.elv's `catch` does. Declining is
# the safe reading -- a caller with no one at the keyboard should not have a
# prompt answered yes on their behalf.
bool wrapper func confirm(...question) {
  text = $question:join(" ")
  print "$text? [Y/n] " >&2
  reply = gets()
  match $reply {
    Y | y | "" => { return true }
    _          => { return false }
  }
}

# return true if this session came in over ssh
bool func connected-via-ssh() { return $env:get(SSH_CONNECTION, "") != "" }

# return true if this session is on a remote machine
bool func connected-remotely() { return connected-via-ssh() }

# return true if this session is attached to shpool
bool func in-shpool() { return $env:get(SHPOOL_SESSION_NAME, "") != "" }

# return true if this session is inside tmux
bool func inside-tmux() { return $env:get(TMUX, "") != "" }

# return true if stdin is a terminal. Pulled out as a helper so tests can
# replace it without rigging up a pty, the same reason shrc has stdin-is-tty.
bool func stdin-is-tty() { return $sh.stdin:tty }

# return true if the current user is root. Reads the $UID env.mesh already
# computed rather than forking `id -u`: bash, zsh and fish read their own $UID
# for free and this runs on every prompt, so a fork per prompt is one this
# config has no reason to pay.
bool func i-am-root() { return $env:get(UID, "") == "0" }

# report whether an ssh key is loaded.
#
# The value call answers with the wrapped command's status, and a status is a
# condition in its own right -- true exactly when the code is 0 -- so there is
# nothing to translate into a bool. This used to run `quiet` in command position
# and branch on `$sh.status`, because a value call then yielded a bare int and
# mesh reads no int as a condition; a status is a value of its own type now.
#
# A hook: redefine it in ~/.rc.local.mesh for a site-specific notion of
# "authenticated". A bool is just as good an answer. It is deliberately
# unbounded -- auth-info is what puts it under a time limit, so an override
# inherits that guard instead of having to reimplement it.
status func is-ssh-valid() { return quiet(ssh-add, -L) }

# how long the check named by $name may take, defaulting to $fallback.
#
# Plain seconds -- `2`, `0.5` -- rather than one of mesh's own duration
# spellings, because shrc reads the same two variables and hands them to
# sleep(1), where `500ms` is an error. The value is passed to `timeout` as
# written; a spelling it cannot read is its own to report.
str func check-limit(name, fallback) {
  limit = $env:get($name, "")
  return $fallback if $limit == ""
  return $limit
}

# print which things need re-authenticating, pre-colored, or nothing.
#
# A hook: ~/.rc.local.mesh can replace it to report Kerberos, AWS SSO, and so
# on. bounded-auth-info is what the prompt calls, so an override inherits a
# limit of its own.
str func auth-info() {
  # Bounded because a stale $SSH_AUTH_SOCK -- a forwarded agent whose ssh
  # connection has gone away -- leaves `ssh-add -L` waiting on a socket nobody
  # answers, and this renders every prompt. The limit is here rather than in
  # is-ssh-valid so an override of that hook is guarded too, and `timeout`'s
  # 124 makes a check that ran out of time a failed one: the prompt says SSH
  # rather than claiming all is well.
  if timeout check-limit("SSH_VALID_TIMEOUT", "2") is-ssh-valid { return "" }
  return style("SSH", fg: yellow)
}

# auth-info under a time limit -- what the prompt calls.
#
# auth-info is replaceable in its own right, so the limit lives here, once,
# rather than at each call site where the next caller added would quietly miss
# it. The stock hook bounds is-ssh-valid and says SSH; this can only report
# that *something* took too long, so $AUTH_TIMEOUT defaults higher and `auth`
# shows only for an override.
#
# The yellow is re-applied because the answer arrives as text: `timeout` runs
# the call in a fork, and mesh writes no color into a capture. A hook that
# colors its own answer differently is flattened to this file's convention.
str func bounded-auth-info() {
  answer = $(timeout check-limit("AUTH_TIMEOUT", "5") puts auth-info())
  # Any nonzero status is a problem, not just the limit's 124: a hook that
  # raised -- a missing Kerberos or AWS helper, a bad `$env` read -- comes back
  # empty, and reading that as "" would tell the prompt all is well on the
  # strength of a check that never answered. It is the same rule 124 gets.
  return style("auth", fg: yellow) if not $sh.status
  return "" if $answer == ""
  return style($answer, fg: yellow)
}

# return true if anything needs authenticating
bool func need-auth() { return bounded-auth-info() != "" }

# hook for authenticating (to ssh-agent, etc.)
func auth() { ssh-add }
func a() { auth }

# print the connecting ssh client's hostname (best effort), or nothing.
# Tries, in order: LC_CLIENT_HOST (smuggled through by ssh-to, since servers
# commonly AcceptEnv LC_*), reverse DNS of the client IP, then the raw IP.
str func ssh-client-host() {
  return $env.LC_CLIENT_HOST if $env:get(LC_CLIENT_HOST, "") != ""
  return "" unless connected-via-ssh()
  ip = $env.SSH_CONNECTION:words:get(0, "")
  return "" if $ip == ""
  name = ""
  # A *miss* is the ordinary outcome of both -- getent exits 2 for an address
  # with no entry, dig exits 9 when the resolver doesn't answer -- and neither
  # prints anything on stdout when it misses, so the empty capture drives the
  # fallback below. stderr is silenced because a miss is not worth reporting.
  if have-command(getent) {
    # `getent hosts` pads its columns, so the hostname is the second
    # whitespace-separated field rather than the second literal-space one.
    hosts = $(getent hosts $ip 2> /dev/null)
    if $hosts != "" { name = $hosts:words:get(1, "") }
  }
  if $name == "" and have-command(dig) {
    answer = $(dig +short -x $ip 2> /dev/null)
    if $answer != "" { name = $answer:lines[0]:replaceend(".", "") }
  }
  return $ip if $name == ""
  return $name:split(".")[0]
}

# print this machine's name, per ~/.workstation. Cached, empty result
# included, because the file is read on every prompt otherwise.
str func workstation() {
  if $env:get(WORKSTATION_CACHED, "") == "" {
    export WORKSTATION_CACHED = 1
    file = "$env.HOME/.workstation"
    if $file:read {
      export WORKSTATION = $(cat $file)
    } else {
      export WORKSTATION = ""
    }
  }
  return $env:get(WORKSTATION, "")
}

# return true if this machine is my workstation
bool func on-my-workstation() {
  host = $env:get(HOSTNAME, "")
  return false if $host == ""
  return true if $host == workstation()
  return false if $host ~ *laptop*
  user = $env:get(USERNAME, "")
  return false if $user == ""
  return starts-with($host, "$user-")
}

# return true if this machine is my laptop
bool func on-my-laptop() {
  return true if "$env.HOME/.laptop":exists
  return true if $env:get(HOSTNAME, "") ~ *laptop*
  return false
}

# return true if this is a non-production machine I use to get work done
bool func on-my-machine() {
  return true if on-my-workstation()
  return on-my-laptop()
}

bool func on-test-host() { return $env:get(HOSTNAME, "") ~ *test* }

bool func on-dev-host() { return $env:get(HOSTNAME, "") ~ *dev* }

# return true if this machine is a production machine
bool func on-production-host() {
  return false if on-my-machine()
  return false if on-test-host()
  return false if on-dev-host()
  return true
}

# return true if it isn't already obvious which host I'm on
bool func show-hostname-in-title() { return not inside-tmux() }

# log the running of a command to a file
wrapper func log-history(...args) {
  file = $env:get(HISTORY_FILE, "")
  return if $file == ""
  stamp = $(date "+%Y%m%d %H%M%S %z")
  tty = $env:get(TTY, "")
  line = $args:join(" ")
  puts "$stamp $tty $line" >> $file
}

# run a command, or just print what would be run when SIMULATE is true.
# A wrapper: the flags belong to the delegated command, so `run curl --location`
# must reach curl rather than be scanned against this signature.
wrapper func run(cmd, ...args) {
  if $env:get(SIMULATE, "false") == "true" {
    puts "Would run $cmd" ...$args
  } else {
    rest = $args:join(" ")
    logger -p user.info "Running $cmd $rest"
    $cmd ...$args
  }
}

# hook to run the given command under a custom ssh-agent
wrapper func with-agent(cmd, ...args) { $cmd ...$args }

# print the definition of the given command or function
func what(name) { type -a $name }

# run a command under a trace of what it does. mesh has no `set -x`, so this
# is the nearest equivalent: announce the command, then run it.
wrapper func setx(cmd, ...args) {
  rest = $args:join(" ")
  puts "+ $cmd $rest" >&2
  $cmd ...$args
}

###################
# GENERAL FUNCTIONS
# Useful things that could be commands if distributing them wasn't impractical.

# print the age of a file in seconds, failing with `stat`'s own status when it
# can't be read. `stat` has already said why; without the guard its diagnostic
# would be followed by an `unbound variable` for the capture and another for
# the subtraction, three messages for one cause.
#
# The miss is a *status* rather than the empty string this used to answer with.
# That is the parity answer -- shrc:767 and config.fish:330 both end up nonzero
# on the same file, their `expr` / `math` failing on the empty capture, and
# rc.elv:824 returns early putting nothing -- and it is the useful one: `age $f
# && …` and `if age $f` ask the question directly, where a caller comparing
# against `""` had to know the miss was spelled as a string.
#
# `fail`, not `return`, and that is the whole design. A returned status would
# answer the miss but break the hit: an int is not a condition in mesh, so
# `if age($f)` on a *readable* file would be a type error rather than a true.
# Failing puts the miss on the status channel where a condition already reads
# it, which leaves the value channel carrying only ever an int -- so the
# declared type is `int` rather than the `any` a two-typed answer would force.
# Same shape isort, trydiff and applydiff use for the same situation.
int func age(file) {
  stamp = $(stat -c "%Y" $file)
  # Bound rather than read twice, as isort and trydiff bind theirs: the status
  # forwarded is the capture's, not whatever the guard leaves behind.
  produced = $sh.status
  fail $produced if not $produced
  return $(date +%s):int - $stamp:int
}

# look up a hostname in DNS, printing both A and AAAA records
func addr(host) { dig +noall +answer +search $host a $host aaaa | get-address-records }
func ptr(ip) { dig +noall +answer -x $ip ptr | get-ptr-records }

# read hostnames on stdin, printing each one with its addresses on one line.
# The addresses come back one per line and shrc collapses them with `join " "`;
# `${…}` interpolates the value call that does the flattening here.
func with-address-records() {
  while gets hostname {
    puts "$hostname ${one-line($(addr $hostname))}"
  }
}

# read IP addresses on stdin, printing each one with its names
func with-hostnames() {
  while gets ip {
    puts "$ip ${one-line($(ptr $ip))}"
  }
}

# collapse captured multi-line output to a single space-separated line.
#
# `:words` rather than a `:lines` loop that skips the empties: it splits on
# *runs* of whitespace and yields no empty element anywhere, which is exactly
# what shrc's unquoted `$(addr "$hostname")` word split does before `join " "`
# sees it.
str func one-line(text) { return $text:words:join(" ") }

# read BIND-style DNS entries, print the A and AAAA records
func get-address-records() { awk '$3 == "IN" && $4 ~ /^A/ { print $5 }' }

# read BIND-style DNS entries, print the PTR records
func get-ptr-records() { awk '$3 == "IN" && $4 == "PTR" { print $5 }' }

# list this machine's IP addresses, as "<iface> <address>" lines
func ips() {
  # `ip -o` aligns its columns, so `:words` rather than `:split(" ")`: a literal
  # split leaves empties between the columns and the family never lands in [2].
  for line in $(ip -o a sh up primary scope global):lines {
    parts = $line:words
    continue if $parts:len < 4
    if $parts[2] ~ inet* { puts "$parts[1] $parts[3]" }
  }
}
func addrs() { ips }

# list this machine's MAC addresses, as "<iface> <MAC>" lines. Same sed program
# as shrc:602 and config.fish:325 -- it holds the interface name from the `N:`
# line until the matching `link/ether` line arrives -- with two changes forced
# by mesh: it is split across -e expressions because a mesh string is
# single-line, and every backslash is doubled because mesh processes escapes
# inside single quotes as well as double ones, where sh and fish do not.
func macs() {
  ip -s l sh | sed -n \
    -e '/^[0-9][0-9]*:/{s/^[0-9][0-9]*: \\([^:]*\\).*/\\1/;h;}' \
    -e '/^    link\\/ether/{s/^    link\\/ether \\([^ ]*\\).*/ \\1/;H;x;s/\\n//;p;}'
}

# get this machine's public IP address as seen by Google
func myip() { dig +short o-o.myaddr.l.google.com txt @ns1.google.com | tr -d '"' }

# print the list of nameservers
func names() {
  sed -ne '/^nameserver/{s/^nameserver[[:space:]]*//;p}' /etc/resolv.conf
  nmcli dev show 2> /dev/null | sed -ne '/^IP..DNS/{s/[^ ]*: *//;p}'
}

# rename each file to <file>.bak
#
# `--` because a name may begin with one: a wrapper is what lets `bak --weird`
# through the shell, and without the terminator `mv` reads that name as an
# option of its own and refuses it. The text copy is for the same name -- see
# unbak below.
wrapper func bak(...files) {
  for file in $files {
    name = "$file"
    mv -i -- $name "${name}.bak"
  }
}

# undo bak
wrapper func unbak(...files) {
  for file in $files {
    # Text before anything looks at it, as recent and shift-options do: a name
    # that begins with `--` arrives as mesh's Flag value, and `~`, `:replaceend`
    # and `:exists` all want a string. Being a wrapper is what lets such a name
    # through at all; refusing it at the reader would give that back.
    name = "$file"
    if $name ~ *.bak {
      target = $name:replaceend(".bak", "")
      mv -i -- $name $target if $name:exists
    } else {
      mv -i -- "${name}.bak" $name if "${name}.bak":exists
    }
  }
}

# ring the terminal's bell
func bell() { printf "\a" }

# get the user's attention when a command finishes, but only where the bell is
# an attention signal rather than a noise: shrc:1635 gates on xterm and its
# variants, since that is what forwards it to the window manager as an urgency
# hint. Anything else -- a linux console, a dumb TERM under a pipe -- would
# just beep.
func flash-terminal() {
  term = $env:get(TERM, "")
  return unless $term == xterm or starts-with($term, "xterm-")
  bell
}

# print the first line(s) of input as-is and run a command on the rest,
# e.g. `ps | body grep ps`. --lines makes the header more than one line.
#
# Same shape as retry and recent: the count is read off the front rather than
# declared, so a flag belonging to the delegated command
# (`ps | body grep --color=never ps`) reaches it instead of being scanned here.
wrapper func body(...args) {
  # A string, not an integer: the parsed forms below arrive as strings and
  # `:int` refuses an integer, so the default has to be the same shape.
  lines = "1"
  rest = $args
  # Text, for the same reason recent does it: `body -2 grep` hands this an
  # integer rather than a string.
  raw = $rest:get(0, "")
  head = "$raw"
  stripped = $head:stripstart("--lines=")
  numeric = $head:stripstart("-")
  if $stripped != $head {
    lines = $stripped
    rest = $rest:rest
  } else if $rest:len > 1 and $head == "--lines" {
    lines = $rest[1]
    rest = $rest[2..]
  } else if $numeric != $head and $numeric ~ /^[0-9]+$/ {
    # shrc:662's `-<number>`, the form `netstat … | body -2 grep …` uses.
    # Narrowed to digits: shrc matches any `-*` and would read `-x` as a count.
    lines = $numeric
    rest = $rest:rest
  }
  left = $lines:int
  while $left > 0 {
    # `gets` is a command, and a postfix guard takes a value expression, so
    # the end-of-input break is spelled as the `else` branch rather than
    # `break unless gets header`.
    if gets header {
      puts $header
    } else {
      break
    }
    left = $left - 1
  }
  return if $rest:len == 0
  # Bound out of the list rather than spread: a bare `...$list` in command
  # position runs nothing.
  cmd = $rest[0]
  $cmd ...$rest:rest
}

# make a directory and cd to it
func mcd(dir) {
  if $dir:d {
    puts "$dir already exists"
    return
  }
  # `&&`, matching shrc:818 and config.fish:530: a failed mkdir (read-only
  # parent, full filesystem) must not be followed by a cd that reports a
  # second, more confusing error for the same cause.
  mkdir -p $dir && cd $dir
}

# make a temporary directory and cd to it
func mtd() { cd $(mktemp -d) }

# cd to the real directory the given file is in, resolving symlinks
func realdir(file) { dirname $(readlink -f $file) }
func cdfile(file) { cd $(realdir $file) }

# search for a file in parent directories, returning the first one found.
#
# The miss is an empty string rather than shrc's exit status 1: this returns a
# value rather than printing one, and a value function in command position
# prints nothing and captures nothing, so `find_up x && …` has no mesh
# spelling to carry that status to. Ask with an explicit comparison --
# `if find-up("marker") != "" { … }` -- since mesh has no truthy values; a
# string is not a condition. Same shape as config.nu:613, and as
# rootdir/projectname/builddir here.
#
# `:ancestors` walks both ends -- the working directory itself, where the
# search starts, through to `/`, where a marker file can also sit -- so the
# loop is the whole search and the `/` stop condition is the list running out.
str func find-up(name) {
  for dir in pwd():ancestors {
    return "$dir/$name" if "$dir/$name":f
  }
  return ""
}

# print the name of a source file's corresponding test file
str func find-test-file(file) {
  base = $file:base
  dir = $file:dir
  stem = $base:stem
  ext = $base:replacestart($stem, "")
  candidate = "$dir/${stem}_test$ext"
  return $candidate if $candidate:exists
  return ""
}

# join the arguments, placing the first between each of the rest
wrapper func join(sep, ...words) { puts $words:join($sep) }

# replace a file with a sorted version of itself. Staged beside the file and
# moved into place only once `sort` succeeded -- the same reason applydiff
# stages: a sort that dies partway (read error, no space) would otherwise have
# its truncated output moved over the original.
func isort(file) {
  staged = "${file}.bak"
  sort $file > $staged
  produced = $sh.status
  if not $produced {
    rm -f $staged
    error "isort: sort failed; $file is unchanged"
    fail $produced
  }
  mv $staged $file
}

# delete the given line number from a file
func delline(line, file) { sed -i -e "${line}d" $file }

# remove the ssh known host on the given line
func rmkey(line) { delline $line "$env.HOME/.ssh/known_hosts" }

# print the block device the given mount point (or file) lives on
func dev(file) {
  # `df` pads its columns too, so `:words` applies here for the same reason.
  for line in $(df -P -k $file):lines {
    parts = $line:words
    continue if $parts:len == 0
    if $parts:last ~ /^\// { puts $parts[0] }
  }
}

# run a command on each line of stdin, e.g. `ls | each wc -l`
wrapper func each(cmd, ...args) {
  while gets line {
    $cmd ...$args $line
  }
}

# run a command on each null-delimited item from stdin, e.g.
# `find . -print0 | each0 wc -l`
#
# The same loop `each` is, over `gets --nulls`, which reads a NUL-terminated
# item. It used to delegate to xargs because `gets` read a line and nothing
# else and `"\0"` is not a valid escape, so the delimiter could not be spelled
# from here; the cost was that this one ran programs only, where `each` can
# call a mesh function. The loop has no such limit, which is the whole reason
# to prefer it.
#
# Empty input runs the command zero times, matching the shrc and fish loops --
# that is what xargs needed `-r` to be talked into, and a loop gets it for free.
wrapper func each0(cmd, ...args) {
  while gets --nulls item {
    $cmd ...$args $item
  }
}

# see what changes a command would make to a file, e.g. `trydiff mdformat f`
# A failing command leaves partial output behind, and showing that as a
# proposed change is worse than showing nothing: the diff looks like a real
# suggestion. So the preview is gated on the command succeeding, and the
# command's own status is what the caller sees rather than the `rm`'s.
#
# A command condition publishes its own status to the branch it picks, so the
# 130 from a Ctrl-C survives into the report; it is read first thing in the
# branch, before the `rm` below replaces it.
bool func trydiff(cmd, file) {
  temp = "${file}.trydiff.$sh.pid"
  if not $cmd $file > $temp {
    produced = $sh.status
    rm -f $temp
    error "trydiff: $cmd failed; nothing to compare"
    fail $produced
  }
  diff $file $temp
  # `diff` exits 1 when the files differ, which is the whole point of a
  # preview -- returning that would break `trydiff x f && applydiff x f` and
  # make every useful run look failed. Only 2-and-up is a real failure
  # (unreadable file, and so on) and is passed through. shrc masks this with
  # `rm`'s status and config.nu with a `try`; both end up at 0 the same way.
  status = $sh.status
  rm -f $temp
  # `:code` because *ordering* stays same-type -- `$status < 2` is a type error.
  # Equality would not need it: `$status == 0` compares the code directly.
  return true if $status:code < 2
  fail $status
}

# apply the changes trydiff would have made. The output is staged beside the
# file and only moved into place once the command succeeded -- a formatter that
# rejects its input exits nonzero after writing nothing, and moving that over
# the original would lose the file.
func applydiff(cmd, file) {
  staged = "${file}.new"
  if not $cmd $file > $staged {
    produced = $sh.status
    rm -f $staged
    error "applydiff: $cmd failed; $file is unchanged"
    fail $produced
  }
  mv $staged $file
}

# show the most recently changed files; the count defaults to 10. shrc:950
# spells it as a leading -<number> and forwards the rest to ls; the count is
# read off the front here for the same reason retry reads --sleep that way --
# a declared flag is scanned against the whole argument list, so
# `recent --color=never` would be rejected for a flag that belongs to ls.
wrapper func recent(...args) {
  count = 10
  rest = $args
  # Interpolated to text before anything looks at it: a bare `-5` argument
  # arrives as the *integer* -5, not the string the user typed, and the string
  # modifiers below refuse an integer.
  raw = $rest:get(0, "")
  head = "$raw"
  stripped = $head:stripstart("--count=")
  numeric = $head:stripstart("-")
  if $stripped != $head {
    count = $stripped
    rest = $rest:rest
  } else if $rest:len > 1 and $head == "--count" {
    count = $rest[1]
    rest = $rest[2..]
  } else if $numeric != $head and $numeric ~ /^[0-9]+$/ {
    # shrc:954's `-<number>`, the form this is documented with. Kept alongside
    # the long spellings: without it `-5` reaches ls, which rejects it.
    count = $numeric
    rest = $rest:rest
  }
  ls -t -1 ...$rest | head -n $count
}
alias latest = recent --count=1

# list non-empty files, prefixed by timestamp in case sorting is needed
wrapper func nonempty(...args) { find . -size +0 ...$args -printf '%T@ %f\n' }

# keep trying a command until it works, e.g. `retry --sleep=1 ping -c 1 host`
#
# `--sleep` is read off the front by hand rather than declared, because a
# declared flag is scanned against the *whole* argument list -- so
# `retry curl --fail URL` would be rejected for curl's `--fail`. shrc:965 reads
# it as a leading option only and forwards the rest verbatim; this is that same
# rule, and being a wrapper is what lets the forwarded flags through.
wrapper func retry(...args) {
  seconds = 10
  rest = $args
  # Interpolated to text before anything looks at it, as recent does with its
  # count: a `--…` word reaches a wrapper as mesh's Flag value, which compares
  # only with another flag and takes no string modifier, so `== "--sleep"` and
  # `starts-with(…, "--sleep=")` both fail on the value they are meant to read.
  raw = $rest:get(0, "")
  head = "$raw"
  if $rest:len > 1 and $head == "--sleep" {
    seconds = $rest[1]
    rest = $rest[2..]
  } else if starts-with($head, "--sleep=") {
    seconds = $head:stripstart("--sleep=")
    rest = $rest:rest
  }
  return if $rest:len == 0
  # The command word is bound out of the list rather than spread with it: a
  # bare `...$list` in command position runs nothing and evaluates truthy, so
  # `if ...$rest` would loop forever without ever calling anything.
  head = $rest[0]
  tail = $rest:rest
  loop {
    if $head ...$tail {
      bell
      break
    }
    sleep $seconds
  }
}

# run a command with the first argument moved to the end, e.g.
# `first-arg-last grep ~/.history -a foo` runs `grep -a foo ~/.history`
wrapper func first-arg-last(cmd, arg, ...rest) { $cmd ...$rest $arg }

# convert `command target [options] arg...` to `command [options] target arg...`,
# so a function can imply the command and take the subcommand or object first.
# Options must start with `-` and carry their value attached (-ffile,
# --file=file); `--file file` is not supported, matching shrc.
wrapper func shift-options(cmd, target, ...args) {
  options = []
  rest = []
  scanning = true
  for arg in $args {
    # A bare `-5` arrives as the integer -5, and `~` refuses a non-string left
    # operand, so classify a copy as text and forward the argument itself.
    text = "$arg"
    if $scanning and $text != "-" and $text != "--" and $text ~ -* {
      options += [$arg]
    } else {
      scanning = false
      rest += [$arg]
    }
  }
  $cmd ...$options $target ...$rest
}

# convert a time from one timezone to another, each leg under its own $TZ
wrapper func tz2tz(from, to, ...spec) {
  when = $spec:join(" ")
  epoch = $(TZ=$from date -d $when +%s)
  # An unparsable spec or timezone has already been reported by `date`; running
  # the second leg on an empty epoch would bury that under a second diagnostic
  # for the same cause. shrc:1039 and config.fish:684 both `|| return 1` here.
  # The guard also has to come before `$epoch` is read at all: a capture whose
  # command failed leaves the name unbound, not empty.
  fail if not $sh.status
  TZ=$to date -d "@$epoch"
}

# convert a Unix timestamp in microseconds to a human-readable datetime
wrapper func udate(ts, ...args) { date -d "@$(($ts:int / 1000000))" ...$args }

# convert from UTC to local time
func utc2(spec) { date -d "TZ=\"UTC\" $spec" }

# list processes in the given process group
alias pgroup = pgrep -g

# ps with useful default options
wrapper func psc(...args) {
  ps -w -o user,pid,ppid,pgid,start_time,pcpu,rss,comm=EXE ...$args -o args=ARGS
}

# pgrep with default ps options: psgrep [<ps options>] <pattern>
wrapper func psgrep(...args) {
  return if $args:len == 0
  pattern = $args:last
  ps-args = $args:init
  # `pgrep` exits 1 and prints nothing when nothing matched, which is exactly
  # the case the branch below is written for.
  pids = $(pgrep -d "," -f $pattern 2> /dev/null)
  if $pids == "" {
    error "No processes matching $pattern"
    fail
  }
  psc -p $pids ...$ps-args
}

# grep for a pattern in the environment of the processes with the given pids
wrapper func envgrep(pattern, ...pids) {
  for pid in $pids { grep -z $pattern "/proc/$pid/environ" }
}

# grep for a pattern in the environments of processes matching a pattern,
# e.g. `pegrep SSH_AUTH_SOCK xfce4`
func pegrep(env-pattern, proc-pattern) {
  for pid in $(pgrep -f "^$proc-pattern"):lines {
    puts "$(ps -o pid= -o args= -p $pid) $(envgrep $env-pattern $pid)"
  }
}
func peg(env-pattern, proc-pattern) { pegrep $env-pattern $proc-pattern }

###############
# SSH
# Connect to a host telling it who is connecting, and give every ~/.ssh/config
# Host entry a command of its own. Ported from shrc:2459 and config.fish:900.

# ssh to a host, smuggling this machine's name across as LC_CLIENT_HOST --
# servers commonly AcceptEnv LC_*, which is why it rides in that namespace, and
# ssh-client-host reads it at the far end. SendEnv is additive, so the usual
# LANG/LC_* forwarding is left intact.
#
# Carried on a `VAR=value cmd` prefix rather than exported here, so it reaches
# the child without outliving the call.
wrapper func ssh-to(host, ...args) {
  client = short-hostname()
  if have-command(rw) and $args:len == 0 {
    LC_CLIENT_HOST=$client rw -r $host
    return
  }
  # ssh flags typed *after* the host alias have to be moved in front of it, or
  # ssh runs them as the remote command -- `host1 -v uptime` remotely ran
  # `-v uptime`. Unlike shift-options, a flag whose value is a separate word
  # (-p 2222, -i file, -o opt) must keep its value with it rather than having
  # the scan stop there. The letter list is OpenSSH's value-taking options.
  nopts = 0
  expect-value = false
  for arg in $args {
    if $expect-value {
      expect-value = false
      nopts = $nopts + 1
      continue
    }
    # Interpolated to text first: a bare `-2` style argument arrives as an
    # integer, which the pattern tests below refuse.
    word = "$arg"
    if $word == "--" {
      # End of options: rotated along with them so it lands before the host,
      # which ssh accepts; everything after it is the remote command even if
      # it starts with a dash.
      nopts = $nopts + 1
      break
    }
    break if $word == "-"
    # A value-taking option at the *end* of a short-option cluster still takes
    # its value as the next word: `-vp 2222` is `-v -p 2222`. Anything after
    # the letter in the same word is an attached value instead (`-p2222`,
    # `-lBob`), so the letters before it must all be *flags*: the first
    # value-taking letter ends the cluster and everything after it belongs to
    # that option. The two sets are ssh(1)'s own -- the prefix is the boolean
    # cluster from its SYNOPSIS, the last letter one of the options the
    # SYNOPSIS gives an argument.
    #
    # shrc and config.fish matched a single letter here, so both built
    # `ssh -vp host1 2222 …` and ssh read the *host* as the port; they now
    # ask an ssh_option_takes_value helper the same question.
    if $word ~ /^-[46AaCfGgKkMNnqsTtVvXxYy]*[BbcDEeFIiJLlmOoPpQRSWw]$/ {
      expect-value = true
      nopts = $nopts + 1
      continue
    }
    if $word ~ -* {
      nopts = $nopts + 1
      continue
    }
    break
  }
  opts = $args[0..$nopts]
  cmd = $args[$nopts..]
  LC_CLIENT_HOST=$client ssh -t -oSendEnv=LC_CLIENT_HOST ...$opts $host ...$cmd
}

# Give each `Host` alias in ~/.ssh/config a command of its own, so a bare
# hostname connects to it.
#
# shrc:2526 and config.fish:962 `eval` one function definition per name. mesh
# defines them directly: `alias $name with ($name) = ...` bakes that pass's
# host into the body, where an alias body is otherwise syntax read at call time
# and `$name` would be unbound by then. Nothing reaches disk, so the three
# shells now build their aliases the same way and rebuild them on each
# interactive start.
#
# This used to generate a cache file and source it, because mesh had neither
# `eval` nor a way to bake a value into a definition (mikelward/mesh#436). That
# cost a staged file, a 0600 mode so the host list was not published to other
# local users through ~/.cache, an atomic rename so a second shell starting at
# once could not read a half-built file, and a child `mesh` run to syntax-check
# the result before it replaced a known-good generation. None of it is needed
# when there is no file.
func set-up-ssh-aliases() {
  config = "$env.HOME/.ssh/config"
  return unless $config:f
  # Bound and checked rather than iterated inline. `~/.ssh/config` passed the
  # `:f` test above, but it can still fail to read -- permissions changed since,
  # an I/O error -- and a failing capture in a `for` head simply iterates
  # nothing and carries on, which would look exactly like a config naming no
  # hosts.
  contents = $(cat $config)
  if not $sh.status {
    warn "ssh aliases: cannot read the ssh config; host aliases are not defined"
    fail
  }
  for line in $contents:lines {
    parts = $line:words
    continue if $parts:len < 2
    keyword = $parts[0]
    continue unless $keyword == Host or $keyword == host
    for name in $parts[1..] {
      # Patterns and negations aren't hosts to connect to. Spelled as a regex
      # rather than a glob because the characters being looked for are `*` and
      # `?` themselves, which a glob would read as wildcards. `-` is excluded
      # by the same rule in shrc and fish.
      continue if $name ~ /[*?-]/
      # Stricter than shrc and fish, which eval whatever they find, and
      # deliberately so on both counts: an FQDN alias isn't wanted here, and a
      # dotted name is a *syntax* error in mesh rather than an odd function
      # name (mikelward/mesh#293).
      continue unless $name ~ /^[A-Za-z_][A-Za-z0-9_]*$/
      # A `Host status` must not take over the `status` shortcut. shrc:2563 and
      # config.fish:998 get this from ordering -- they generate ssh aliases
      # before their shortcut blocks, so the shortcut is defined last and wins.
      # That ordering isn't available here: the shortcuts are file-scope
      # definitions above the interactive section (which is what keeps this
      # file sourceable from a test), so they are always in place first.
      # Skipping a name that is already a function is the same rule stated
      # directly. `is-function` rather than `is-runnable`, so a host may still
      # be named after a *program* -- shadowing `git` with a host alias is the
      # user's call, exactly as in the other shells.
      continue if is-function($name)
      # A name mesh owns can't be defined at all -- `Host files` is the sharp
      # case, `files` being a built-in value call. mesh reports such a name and
      # the loop carries on, so an entry a *later* mesh grows into refusing
      # costs only its own alias; the generated file used to lose every one of
      # them, which is what the child syntax-check was there to prevent.
      continue if is-shell-name($name)
      # `wrapper func` semantics, by the rule at the top of this file:
      # everything the user types after the host belongs to ssh or to the
      # remote command, so nothing here may be scanned as a flag of this
      # alias's own. `alias` desugars to exactly that.
      alias $name with ($name) = ssh-to $name
    }
  }
}

#####################
# PROJECT AND VCS
# The per-VCS work lives in the `vcs` binary; these are the thin wrappers the
# prompt and the everyday shortcuts need. shrc.vcs generates a function per
# `vcs` subcommand with `eval`, which mesh has no equivalent for, so the
# shortcuts below are written out instead.

# print the root directory of the current project, or nothing
str func rootdir() {
  return "" unless have-command(vcs)
  return $(command vcs rootdir 2> /dev/null || true)
}
str func projectroot() { return rootdir() }
func pr() { puts projectroot() }

# print the name of the current project
str func projectname() {
  root = projectroot()
  return "" if $root == ""
  return $root:base
}
func project() { puts projectname() }

# return true if we are inside a VCS workspace
bool func inside-project() { return projectroot() != "" }

# print the directory that builds are relative to
str func buildroot() { return projectroot() }

# print the path from buildroot to the working directory
str func builddir() {
  root = buildroot()
  here = pwd()
  return "." if $here == $root or $root == ""
  return $here:replacestart("$root/", "")
}

# cd to the root of the current project
func rd() {
  root = rootdir()
  return if $root == ""
  cd $root
}

func vcs-backend() { command vcs backend }
func vcs-hosting() { command vcs hosting }
alias prompt-info = command vcs prompt-info
func unmerged() { command vcs unmerged }
func cv() { command vcs clearcache }

# Give every `vcs` subcommand a command of its own, so `commit` runs
# `vcs commit`. shrc.vcs:135 generates these with `eval` over the same
# `vcs --list-commands`; mesh defines them directly, since `alias $name with
# ($name) = ...` bakes the subcommand into the body -- an alias body is
# otherwise syntax read at call time, where the loop variable is long gone.
#
# The list comes from the binary rather than being restated here, which is the
# TODO this replaces (carried from config.nu:1522): the hand-written list had
# drifted to 35 of the 74 subcommands vcs ships, and every addition to the
# binary needed a matching edit in each shell's config to be reachable.
#
# Costs one `vcs --list-commands` per interactive start, about 3ms on this
# machine -- a process spawn and a write, no network and no disk beyond the
# binary itself. Nothing runs at all when `vcs` is not installed.
func set-up-vcs-aliases() {
  return unless have-command(vcs)
  # stderr is left alone rather than sent to /dev/null: when an installed vcs
  # rejects `--list-commands` -- an older build, a broken one -- its own message
  # is the only thing that says *why* every shortcut just disappeared, and the
  # warning below can only say that one did.
  commands = $(command vcs --list-commands)
  # Bound and checked rather than iterated inline: a failing capture in a `for`
  # head iterates nothing and carries on, which would silently leave every
  # shortcut undefined and look exactly like a vcs that ships no subcommands.
  if not $sh.status {
    warn "vcs shortcuts: cannot list the subcommands; they are not defined"
    fail
  }
  for name in $commands:lines {
    # A name the binary grows that mesh cannot bind is reported and skipped,
    # costing only itself; the rest of the shortcuts are defined either way.
    continue unless $name ~ /^[A-Za-z_][A-Za-z0-9_-]*$/
    # A shortcut this file defines with behavior of its own keeps it --
    # `rootdir` silences stderr, `unmerged` is its own wrapper -- exactly as it
    # did when these were written out below it.
    continue if is-function($name)
    # `status` is a mesh builtin (the status-value constructor) and a builtin's
    # name is refused as a `func` or `alias`. `st` below is the spelling that
    # survives, and `vcs status` always works.
    continue if is-shell-name($name)
    alias $name with ($name) = command vcs $name
  }
}

# short aliases -- hand-picked, not generated, matching config.nu:1566
alias am = command vcs amend
alias ci = command vcs commit
alias di = command vcs diffs
alias gr = command vcs graph
alias lg = command vcs graph
alias ma = command vcs review
alias st = command vcs status

# clone a repo with whichever VCS its URL implies: jj for a git URL (falling
# back to git itself, but only if the user says so), hg for an hg one. Not an
# alias, because the choice is the whole point. Matches shrc.vcs:141,
# config.fish:1793 and config.nu:1566.
#
# The URL comes first: `clone URL --depth 1`, not `clone --depth 1 URL`. The
# URL is what picks the VCS, so a leading flag would bind to `url` and match
# neither pattern -- shrc.vcs:142's `case "$1"` and config.nu's `url: string`
# have the same shape and the same requirement.
#
# A wrapper all the same, so the flags that follow the URL reach the clone
# command rather than being scanned against this signature.
wrapper func clone(url, ...args) {
  # Matched on the text rather than on `url` itself: a caller who led with an
  # option binds mesh's Flag value here, and `~` takes a string on the left. A
  # flag matches neither pattern, which is how a misordered call still does
  # nothing rather than erroring at the reader.
  target = "$url"
  if $target ~ *.git {
    if have-command(jj) {
      jj git clone $url ...$args
    } else if confirm("jj is not installed. Clone using git") {
      git clone $url ...$args
    }
  } else if $target ~ */hg* {
    hg clone $url ...$args
  }
}

#####################
# SESSION MANAGEMENT
# shpool is the default; tmux is the fallback when shpool is missing or
# WANT_SHPOOL=0. SESSION_BACKEND=tmux flips the preference. Kept in parity
# with shrc, config.fish, and config.nu.

# return true if we should auto-start shpool in this session. The autoshpool
# helper is required as well as shpool: a machine with shpool that hasn't
# picked up the scripts repo must fall through to tmux rather than failing on
# a missing autoshpool at every shell start.
bool func want-shpool() {
  return false if $env:get(WANT_SHPOOL, "1") == "0"
  return false unless stdin-is-tty()
  return false if in-shpool()
  return false if inside-tmux()
  return false unless have-command(shpool)
  return false unless have-command(autoshpool)
  return true if connected-remotely()
  return inside-project()
}

# return true if we should auto-start tmux in this session
bool func want-tmux() {
  return false if $env:get(WANT_TMUX, "1") == "0"
  return false unless stdin-is-tty()
  return false if inside-tmux()
  return false if in-shpool()
  return false unless have-command(tmux)
  return false unless have-command(autotmux)
  return true if connected-remotely()
  return inside-project()
}

# name of the preferred session manager: "shpool" (the default when both are
# available), "tmux" (the fallback), or empty when neither is enabled.
#
# The two availability checks answer `bool`, which cost them one conversion: a
# `have-command` on the last line is a *status*, so it used to make these two
# answer with a bool on the lines that decide and a status on the line that asks
# PATH. cab5193 left that mixture alone because no caller could tell them apart,
# and it was harmless right up until a declared type had to name one of them.
#
# `bool` rather than `status` because these are questions, and nothing calls
# them for a code. Both live only inside session-backend below, in four postfix
# guards; unlike the rest of the session helpers they have no shrc, fish or
# nushell counterpart to stay in parity with -- those inline the same three
# conditions into their own session_backend -- so nothing outside this file
# reads them either. Given that, `true`/`false` is what the *names* promise a
# reader, where `0` for yes would read backwards.
#
# The conversion is a postfix guard rather than a comparison. `== 0` reads
# well and is one line shorter, but it pins have-command to answering a
# *status* specifically -- and that is not something this file gets to assume.
# The tests stub have-command with a bool (it is the single choke point they
# replace to keep a real shpool off the host), and ~/.rc.local.mesh may too, so
# a comparison against a code turns "cannot compare a bool with an int" the
# moment either does. A guard takes any condition, which is all this needs to
# know about the answer.
bool func shpool-available() {
  return false if $env:get(WANT_SHPOOL, "1") == "0"
  return false unless have-command(shpool)
  return true if have-command(autoshpool)
  return false
}

bool func tmux-available() {
  return false if $env:get(WANT_TMUX, "1") == "0"
  return false unless have-command(tmux)
  return true if have-command(autotmux)
  return false
}

str func session-backend() {
  if $env:get(SESSION_BACKEND, "shpool") == "tmux" {
    return tmux if tmux-available()
    return shpool if shpool-available()
    return ""
  }
  return shpool if shpool-available()
  return tmux if tmux-available()
  return ""
}

# attach to (or create) this project's session using the preferred backend
wrapper func autosession(...args) {
  match session-backend() {
    tmux   => { autotmux ...$args }
    shpool => { autoshpool ...$args }
  }
}

# switch to a session. tmux switches in place; shpool requests a switch and
# the now-parked shell exits, which is what hands control to autoshpool's
# outer loop.
func switchshpool(name) { autoshpool switch $name && exit }

func switchsession(name) {
  match session-backend() {
    tmux   => { autotmux switch $name }
    shpool => { switchshpool $name }
  }
}

# attach to a (named) session using the preferred backend
wrapper func sessionattach(...args) {
  match session-backend() {
    tmux   => { tmux attach ...$args }
    shpool => { shpool attach ...$args }
  }
}

# list sessions using the preferred backend
wrapper func sessionlist(...args) {
  match session-backend() {
    tmux   => { tmuxlist ...$args }
    shpool => { shpoollist ...$args }
  }
}

# The launcher only replaces this shell when it actually started a session:
# `autoshpool && exit` rather than a bare `exit`, so a launcher that fails --
# no daemon, bad config -- leaves a working shell behind instead of closing a
# remote login. Same guard shrc, config.fish and config.nu use.
# Transitional fallback: the updated scripts-repo helpers open the session in
# the right directory via `shpool attach -d`, leaving SHPOOL_INITIAL_PWD unset
# and this a no-op. Until that ships everywhere (mikelward/scripts#107), the
# older helpers still stamp SHPOOL_INITIAL_PWD (forwarded via the shpool
# config's forward_env), so cd there on entry. Remove this and the forward_env
# entry once the scripts update is deployed.
# The variable is cleared only once the cd worked: it is the only record of
# where the handoff meant to land, so a directory that has been deleted since
# the launcher stamped it should leave the value in place to diagnose with
# rather than land in the launcher's directory with nothing to show for it.
# `cd` reports its own failure, so there is nothing to add to it.
func apply-shpool-initial-pwd() {
  return unless in-shpool()
  initial = $env:get(SHPOOL_INITIAL_PWD, "")
  return if $initial == ""
  # A postfix guard takes a value, not a command, so the success arm comes
  # first -- the same shape trydiff uses.
  if cd $initial {
    $env.SHPOOL_INITIAL_PWD = ""
    return
  }
  fail
}

# The shell the user explicitly started, for autoshpool to run in the
# sessions it creates (shpool attach --cmd). An inherited value wins (so
# SESSION_SHELL=... overrides); otherwise empty -- and the daemon's default
# shell applies -- unless SHLVL shows a parent shell: mesh increments SHLVL
# before its startup files run, so 1 is the terminal's or login's own first
# shell, the default rather than an explicit choice. The full path from
# `type -P`, because the shpool daemon's PATH may not include where mesh is
# installed; -l so the session's shell starts as a login shell, matching the
# shpool daemon's default spawn. Returned rather than exported so a shell
# that never hands off leaves nothing for later nested shells to inherit;
# the handoff below restores the environment when the launcher fails. Kept
# in parity with shrc, config.fish, and config.nu.
str func session-shell() {
  existing = $env:get(SESSION_SHELL, "")
  return $existing if $existing != ""
  level = $env:get(SHLVL, "0")
  return "" unless $level ~ /^[0-9]+$/
  return "" if $level:int < 2
  return "" unless have-command(mesh)
  exe = $(type -P mesh)
  return "" if $exe == ""
  return "$exe -l"
}

func maybe-start-session-and-exit() {
  match session-backend() {
    shpool => {
      return unless want-shpool()
      # Scoped by hand: set for the launcher, restored when it fails (an
      # empty SESSION_SHELL reads as unset everywhere it is consulted), so a
      # failed handoff does not leave this shell's identity for later nested
      # shells to inherit.
      prev = $env:get(SESSION_SHELL, "")
      $env.SESSION_SHELL = session-shell()
      autoshpool && exit
      $env.SESSION_SHELL = $prev
    }
    tmux => {
      return unless want-tmux()
      prev = $env:get(SESSION_SHELL, "")
      $env.SESSION_SHELL = session-shell()
      autotmux && exit
      $env.SESSION_SHELL = $prev
    }
  }
}

##############################
# PROMPT
# mesh renders color itself through `style`, so the tput probing shrc needs is
# gone. The layout is shrc's: a rule, then a context line of host, directory,
# and anything needing authentication, then a bare `$` to type at.

str func blue(text) { return style($text, fg: blue) }
str func green(text) { return style($text, fg: green) }
str func red(text) { return style($text, fg: red) }
str func yellow(text) { return style($text, fg: yellow) }

# replace a leading $HOME in the working directory with "~".
#
# `:tilde` is mesh's own inverse of the `~` a word expands -- the same code the
# shell's default window title runs -- so the body is four lines of prefix
# surgery handed back to the shell rather than a behavior change. It agrees
# with what was here on every case worth having: a whole-component match, so a
# $HOME of /home/user leaves /home/username alone, which the old
# trailing-slash compare also got right.
#
# The exact-$HOME test stays in front of it for the one case where they part:
# `:tilde` ignores a $HOME of `/` entirely -- reasonably, since otherwise every
# absolute path would render as `~`-something -- but that also leaves the root
# directory as `/` where shrc:1829, config.fish:1562 and config.nu:1347 each
# answer `~` from an exact-home branch of their own. An account or a container
# with HOME=/ is the case, and parity decides it.
str func tilde-pwd() {
  here = pwd()
  return "~" if $here == $env.HOME
  return $here:tilde
}

# a short version of the hostname for the prompt and the window title
str func short-hostname() {
  host = $env:get(HOSTNAME, "")
  return "" if $host == ""
  host = $host:split(".")[0]
  user = $env:get(USERNAME, "")
  return $host if $user == ""
  return $host:replacestart("$user-", "")
}

# print the current session name (shpool or tmux), or nothing
str func session-name() {
  return $env.SHPOOL_SESSION_NAME if in-shpool()
  return $(tmux display-message -p '#S') if inside-tmux()
  return ""
}

# The session and project names for the render in progress. Two callers want
# each of them now -- host-info draws the context line and title-text names the
# window -- and both answers cost a fork: `tmux display-message` inside tmux,
# `vcs rootdir` inside a repo. Warmed once per render so a prompt pays one of
# each instead of two. shrc:2204 warms `_session_name` across exactly this pair
# for the same reason, and config.fish:1509 does too.
#
# shrc drops its cache at the end of the render; this cannot, because the title
# is its own hook and runs *after* preprompt returns. The flag stays set and
# preprompt re-warms it every time, so the values a reader sees are the ones
# from the prompt it is sitting at -- which is also what makes them right for
# preexec, where nothing has changed between the prompt and the command it
# launched. Cold -- a test, a direct call before any prompt -- asks for itself.
prompt-cache-warm = false
prompt-session-name-cached = ""
prompt-project-name-cached = ""

func warm-prompt-cache() {
  global prompt-session-name-cached = session-name()
  global prompt-project-name-cached = projectname()
  global prompt-cache-warm = true
}

str func prompt-session-name() {
  return $prompt-session-name-cached if $prompt-cache-warm
  return session-name()
}

str func prompt-project-name() {
  return $prompt-project-name-cached if $prompt-cache-warm
  return projectname()
}

# Cold again once the command line is away. Everything from here until the next
# prompt is the user's own command, which may `cd` or switch branches, so a
# command that reaches title-text or host-info -- `cd /tmp; puts title-text()`
# is the sharp case -- must get live answers rather than the ones the prompt
# drew with. The other shells never had this to worry about: theirs resolve on
# every call and shrc's cache is dropped at the end of its own render, which is
# the line this replaces.
#
# Its own preexec hook, registered last, rather than a line at the end of
# title-busy: the cache's lifetime should not depend on the title being
# registered at all, and that coupling is exactly what left it stale. Takes the
# command mesh hands every preexec handler, and ignores it.
func cool-prompt-cache(cmd) {
  global prompt-cache-warm = false
}

# the hostname and session tag for the context line. The hostname is red on a
# production host; the session tag is a green session name when attached, or a
# yellow warning naming the backend that would start when not.
str func host-info() {
  host = short-hostname()
  if on-production-host() { host = red($host) }
  # `${f()}` interpolates a value call, which is what lets these read as the
  # line they render. The bare `$(f)` form is still a *command* capture -- it
  # would run `f` as a command and take its stdout, where these return a value
  # rather than printing one -- so the braces are the whole difference.
  out = ""
  if i-am-root() { out = "[${red(root)}] " }
  out += "$host "
  session = prompt-session-name()
  return "$out${green($session)}" if $session != ""
  backend = $env:get(SESSION_BACKEND, "")
  if $backend == "" { backend = session-backend() }
  if $backend == "" { backend = shpool }
  return "$out${yellow($backend)}"
}

# the directory part of the context line: `vcs prompt-info` renders it (one
# fork), and outside a repo the binary prints nothing, so we fall back to a
# tilde-shortened $PWD. Deliberately *not* gated on inside-project(), which
# would spend a whole `vcs rootdir` fork per prompt to learn what the empty
# output already says -- the same reason config.fish and config.nu call
# prompt-info unconditionally. have-command is a PATH lookup, not a fork.
str func dir-info() {
  info = ""
  if have-command(vcs) {
    info = $(command vcs prompt-info --color=always 2> /dev/null || true)
  }
  if $info == "" { info = tilde-pwd() }
  return blue($info)
}

# the context line: host, directory, and anything needing authentication.
# `auth` is a parameter so preprompt can compute the answer once and hand the
# same one to maybe-background-fetch: `ssh-add -L` (via is-ssh-valid) is a
# fork, and the two limits around it are two more, so asking twice per prompt
# would double all three. Defaulted for direct callers, matching the "captured
# once per prompt" note at shrc:1563.
str func prompt-line(auth = bounded-auth-info()) {
  out = "${host-info()} ${dir-info()}"
  return $out if $auth == ""
  return "$out $auth"
}

# a rule the width of the terminal. `$sh.width` is read from the terminal at
# each access, so it cannot go stale across a resize, and it costs an ioctl
# rather than the `tput cols` fork this used to pay on every prompt. It is 0
# when there is no terminal at all -- a redirected prompt, a test harness --
# which is not a width, so 80 is this file's choice for that case.
int func terminal-width() {
  return 80 if $sh.width == 0
  return $sh.width
}

func bar(width) {
  rule = ""
  left = $width
  while $left > 0 {
    rule += "―"
    left = $left - 1
  }
  puts $rule
}

# a single line naming every live job, for the context block
str func job-info() {
  return "" if $sh.jobs:len == 0
  out = ""
  for id, job in $sh.jobs {
    # The prompt's own `vcs` plumbing shows up as a job under some shells;
    # a deliberate `vcs foo &` reads as `vcs foo`, so only the wrapped form
    # is dropped.
    continue if starts-with($job.cmd, "command vcs")
    if $out != "" { out += " " }
    out += "%$id $job.cmd"
  }
  return $out
}

# Resolve the per-shell file publish-jobs writes to, so a status-bar consumer
# (tmux, screen) can show this shell's jobs without querying a foreign shell's
# job table. Keyed by $TTY -- the pty path -- rather than a multiplexer's pane
# id, so the same scheme works in any multiplexer and outside one.
#
# Empty, and publishing silently off, unless $TTY is a /dev/... path and
# $XDG_RUNTIME_DIR is set. There is deliberately no /tmp fallback: a
# predictable per-uid path there lets a local user pre-create the leaf as a
# symlink and have this shell truncate the target on every prompt.
# $XDG_RUNTIME_DIR is per-user mode 0700 on modern Linux.
str func publish-jobs-file() {
  tty = $env:get(TTY, "")
  return "" unless starts-with($tty, "/dev/")
  xdg = $env:get(XDG_RUNTIME_DIR, "")
  return "" if $xdg == ""
  return "$xdg/shell-jobs$tty"
}

# Write a "%N command %M command " summary (trailing space, no newline, empty
# for no jobs) so the consumer can just `cat` it. Only the command word is
# published, not its arguments -- shrc:1825 and config.fish:1691 reduce their
# job lines with the same awk. Called from preprompt, so it refreshes on every
# redraw.
# Set once a failed write has turned publishing off, so the warning below is
# said one time rather than once per prompt.
#
# A file-scope variable rather than an exported one, which is what this used to
# be: the failure is *this* shell's -- its $TTY, its $XDG_RUNTIME_DIR -- and an
# export handed the disable to every shell this one started, including ones
# whose own path was perfectly writable. Through a daemon's inherited
# environment it reached further still: one bad shell could switch job
# publishing off for every shpool session opened afterwards. Same class of leak
# as an inherited $TTY, and the fix is the same -- keep per-shell state in the
# shell.
shell-jobs-disabled = false

func publish-jobs() {
  file = publish-jobs-file()
  return if $file == ""
  # One failed write turns publishing off for the rest of this shell. This runs
  # on every prompt, so a warning per prompt would be worse than the problem it
  # reports; said once, then stopped.
  return if $shell-jobs-disabled
  # A stale-but-set $XDG_RUNTIME_DIR -- a long-lived multiplexer session whose
  # /run/user/$UID was cleaned up -- disables publishing for this prompt rather
  # than breaking the render, as config.nu:867's `try` does.
  quiet mkdir -p $file:dir
  return unless $sh.status
  summary = []
  for id, job in $sh.jobs {
    # Same filter as job-info: the prompt's own `vcs` plumbing isn't a job the
    # user started.
    continue if starts-with($job.cmd, "command vcs")
    word = $job.cmd:words:get(0, "")
    summary += ["%$id $word"]
  }
  text = ""
  if $summary:len > 0 {
    joined = $summary:join(" ")
    text = "$joined "
  }
  # `print` rather than `puts`: the format has no trailing newline.
  print $text > $file
  if not $sh.status {
    # A partial write leaves a truncated line, which a status bar would read as
    # a real job list -- worse than no file. Drop it and stop trying.
    rm -f $file
    global shell-jobs-disabled = true
    warn "shell jobs: cannot write the status file; publishing is off for this shell"
  }
}

# Remove this shell's file on the way out, so it doesn't linger and mislead the
# next shell on the same pty. mesh has an `exit` hook, so this matches shrc's
# EXIT trap and fish's fish_exit handler; config.nu:841 has to do without one.
func unpublish-jobs(status = 0) {
  file = publish-jobs-file()
  return if $file == ""
  rm -f $file
}

# the window title: "<hostname> <session> <project-or-pwd>", each leading part
# omitted when empty.
#
# `title-text` rather than `title`, which is now mesh's builtin for naming the
# window and so is refused as a function name. That builtin is the mechanism;
# the interface is a pair of hooks -- `preprompt` for where the shell is while
# it waits, `preexec` for what it is running while it is busy -- and mesh's own
# titles are ordinary prelude functions registered on them (`puts $sh.prelude`
# prints them). Registering over the `title` hook name replaces them.
str func title-text() {
  parts = []
  if show-hostname-in-title() { parts += [short-hostname()] }
  session = prompt-session-name()
  if $session != "" { parts += [$session] }
  name = prompt-project-name()
  if $name == "" { name = pwd():base }
  parts += [$name]
  return $parts:join(" ")
}

# Both moments get the same text, which is the parity call rather than the
# mesh-native one: shrc's preprompt and precommand both `set_title "$(title)"`,
# and rc.elv's preprompt and command-started both `set-title (title)`. mesh
# ships the command line as the busy title instead; taking that here would make
# mesh the one shell whose window says something different mid-command.
func title-idle() { title title-text() }
func title-busy(cmd) { title-idle }

# spawn a detached background fetch through the `vcs` binary, which knows the
# right fetch command per VCS, the marker file to mtime-gate against, and how
# to detach. The shell owns only two gates: skip unless the directory changed
# (most prompts don't follow a cd), and skip while something needs
# authenticating so the prompt's {behind} indicator still nags.
#
# The directory is recorded only once a fetch is actually spawned. Recording it
# before the auth gate -- which is what shrc and config.fish used to do -- means
# a directory first seen without an ssh identity never fetches, however long the
# session stays there after the user authenticates. `auth` comes from preprompt
# so the retry costs no extra `ssh-add -L`.
last-fetch-dir = ""
func maybe-background-fetch(auth = bounded-auth-info()) {
  here = pwd()
  return if $here == $last-fetch-dir
  return unless have-command(vcs)
  return if $auth != ""
  # Recorded only once the spawn succeeded. `vcs auto-fetch` is mtime-gated
  # inside the binary, so a successful call is cheap to repeat; a failed one
  # (couldn't fork, couldn't reach the marker file) is worth retrying on the
  # next prompt rather than disabling the fetch for this directory until the
  # next cd.
  quiet command vcs auto-fetch
  return unless $sh.status
  global last-fetch-dir = $here
}

# what the prompt draws before each command line
func preprompt() {
  # Asked once and handed to both callers below: is-ssh-valid forks `ssh-add -L`
  # and each `timeout` around it forks again, and this is the prompt's hot path.
  auth = bounded-auth-info()
  # Before anything reads them: the context line below and the title hook that
  # runs after this returns both want the session and project names, and both
  # cost a fork.
  warm-prompt-cache
  maybe-background-fetch $auth
  puts ""
  bar terminal-width()
  puts prompt-line($auth)
  # `unmerged` prints the warning, so only its diagnostics are silenced -- and
  # it is not gated on inside-project() for the same reason dir-info isn't:
  # the binary answers empty outside a repo, and the gate would cost a second
  # `vcs rootdir` fork on every prompt. shrc, config.fish and config.nu all
  # call it unconditionally too.
  if have-command(vcs) { unmerged 2> /dev/null }
  publish-jobs
  jobs-line = job-info()
  puts $jobs-line if $jobs-line != ""
  # Last, as in shrc:1483 and config.fish:1384: the bell announces a prompt
  # that is already drawn.
  flash-terminal
}

# report a command that failed or took a noticeable while, the way shrc's
# last_job_info does -- but from mesh's postexec hook, which is handed the
# status and the elapsed milliseconds rather than having to recover them.
str func format-duration(ms) {
  seconds = $ms / 1000
  return "" if $seconds < 2
  hours = $seconds / 3600
  seconds = $seconds - $hours * 3600
  minutes = $seconds / 60
  seconds = $seconds - $minutes * 60
  return "$hours hours $minutes minutes $seconds seconds" if $hours > 0
  return "$minutes minutes $seconds seconds" if $minutes > 0
  return "$seconds seconds"
}

func command-finished(cmd, status, elapsed) {
  reported = ""
  # Integer arms: a status compares to an int by its code, so these read as the
  # exit codes they are. 130 is SIGINT, 148 SIGTSTP -- both expected, not errors.
  match $status {
    0   => { }
    130 => { reported = red("interrupted") }
    148 => { }
    _   => { reported = red("status $status") }
  }
  duration = format-duration($elapsed)
  if $duration != "" {
    if $reported != "" { reported = "$reported " }
    reported += yellow("took $duration")
  }
  puts $reported if $reported != ""
}

# log every interactive command, the way shrc's precommand does
func command-started(cmd) { log-history $cmd }

##########################
# COMMAND SHORTCUTS
# shrc spells most of these as aliases, and so does this file: mesh's `alias
# NAME = COMMAND` is sugar for a `wrapper func`, so each one forwards every
# argument -- an undeclared long flag included -- to what it wraps. A plain
# `func` would reject `l --color=never` and answer `l --help` itself.
#
# `command` reaches past the function of the same name, which is what makes the
# shortcuts that share a name with what they wrap safe. It is written out even
# where `alias` would insert it, so the guard stays visible.
#
# Anything that does more than forward -- a pipe, an `and`, a flag after the
# arguments, or a body with logic -- stays a `wrapper func`, since an alias
# body is a single plain command.

alias c = command less --quit-if-one-screen --no-init
func cdf(file) { cdfile $file }
alias cg = command rg --glob="{*.c,*.h,*.cc,*.cpp,*.hh,*.coffee,*.go,*.hs,*.java,*.js,*.pl,*.py,*.sh,*.rb,*.swig,*.ts}"
alias ct = command ctags -R
alias cx = command chmod +x
# restart a background daemon. `fork` so the `&` job belongs to the subshell
# and doesn't linger in `$sh.jobs`, where it would make `safe-exit` refuse to
# leave -- shrc's `( setsid "$1" & )` detaches for the same reason, and setsid
# puts it in a session of its own so it outlives this shell.
wrapper func daemon(name, ...args) {
  # pkill exits 1 when nothing was running, which is the normal first start
  pkill $name
  fork { setsid $name ...$args & }
}
# shrc and config.fish used to pass their arguments to a `daemon` that only
# ever looked at the name, so `bindkeys --poll-rc` silently dropped the flag;
# all four shells forward them to xbindkeys now.
alias bindkeys = daemon xbindkeys
alias diga = command dig +noall +answer +search
alias digs = command dig +short +search
# `&&` rather than two statements: a failed `cd` would otherwise leave wget
# saving into whatever directory the caller happened to be in. `cd` prints its
# own diagnostic, so there is nothing to add to it.
wrapper func download(...args) {
  cd "$env.HOME/Downloads" && command wget ...$args
}
# a value call cannot stand in command position, so the program is bound first
wrapper func e(...args) {
  editor = $env:get(EDITOR, vim)
  $editor ...$args
}
# terminal mode, so `emacs file` stays in the shell it was typed in rather than
# opening a window when a display happens to be available. shrc:2682 spells it
# `--no-window-system`, config.fish:1176 uses the `-nw` short form.
alias emacs = command emacs --no-window-system
alias eg = g -E
alias g = command grep --binary-files=without-match --line-number
alias gdb = command gdb -q
# note that grep options must go after ~/.history
alias gh = first-arg-last grep "$env.HOME/.history" -a
alias github = command gh
alias gitdir = command git rev-parse --git-dir
func gl() { cd /var/log }
alias h = command head
alias headers = command curl --location --include --silent --show-error --output /dev/null --dump-header -
alias hms = command date +"%H:%M:%S"
alias hmsns = command date +"%H:%M:%S.%N"
alias hosts = command getent hosts
alias ipy = command ipython
alias ipy3 = command ipython3
func j() { jobs }
# No `command` prefix, unlike shrc:2683 and config.fish:1177: those reach past
# their own `fg` *function*, while here `fg` is mesh's builtin and `command`
# would look past it to a program that doesn't exist.
alias f = fg
alias killcode = command pkill -f /usr/share/code/code
alias kssh = command ssh -o PreferredAuthentications=publickey
# Three listers, picked the way shrc:2696 picks them: the separate `l` program
# when this host has one, else GNU-style `ls` if it takes those flags, else a
# plain `ls`. The middle arm has to be probed rather than assumed -- BSD and
# macOS `ls` reject `--color=auto` outright, which would break `l` and every
# shortcut built on it. One fork at startup, as in shrc.
if have-command(l) {
  alias l = command l -K -v -e -x
  alias ll = l -p -T -B -V -h --time-style=relative
  alias lt = l -T -t
} else if command ls --color=auto -v -d / > /dev/null 2> /dev/null {
  alias l = command ls --color=auto -v -b -x
  alias ll = l -l
  alias lt = ll -t
} else {
  alias l = command ls -v -b -x
  alias ll = l -l
  alias lt = ll -t
}
alias l1 = l -1
alias la = l -a
alias lc = l -C
alias lssock = command lsof -a -n -P -i
alias lss = lssock
alias m = command make -f .Makefile
func ml() { m lint }
func mt() { m test }
alias n = command date +"%Y%m%d%H%M%S"
alias now = command date +"%Y-%m-%dT%H:%M:%S"
alias nowns = command date +"%Y-%m-%dT%H:%M:%S.%N"
alias nv = command nvim
wrapper func p(...args) {
  pager = $env:get(PAGER, more)
  $pager ...$args
}
alias phup = command pkill -HUP
alias psg = psgrep
alias psu = command ps -o user,pid,start,time,pcpu,stat,cmd
alias pssh = command ssh -o PreferredAuthentications=keyboard-interactive,password
alias py = command python
alias py2 = command python2
alias py3 = command python3
alias rg = command rg --follow --line-number
wrapper func rh(...args) { gh ...$args | tail -n 20 }
alias s = command subl
alias spell = command aspell -a
alias sr = command ssh -l root
alias symlink = command ln --symbolic --relative
alias t = command tail
alias tf = t -f
alias tl = t -f /var/log/syslog
alias today = command date +"%Y-%m-%d"
alias userctl = command systemctl --user
alias userjournal = command journalctl --user
alias userjnl = userjournal
alias view = command vim -R -c ":set mouse="
alias v = view
alias vl = view /var/log/syslog
alias wcp = with-agent scp
alias wsh = with-agent ssh
# Refuse to leave while jobs are still running, listing them instead --
# shrc:1421's `_exit`. Kept under a kebab-case name now that mesh takes a
# leading underscore, since that is this file's convention and `_exit` reads as
# shell-private rather than as something to type. There is no non-job-control
# arm: mesh publishes $sh.jobs unconditionally, where shrc has to check for
# `-m` first.
wrapper func safe-exit(...args) {
  if $sh.jobs:len == 0 {
    exit ...$args
  }
  jobs
}

# resume each suspended job in turn, then leave. `fg` reports "no current job"
# on stderr when the last one is done, which is the loop's exit condition, so
# only that stream is silenced -- as config.fish:1277 silences it.
wrapper func xa(...args) {
  loop {
    if fg 2> /dev/null { continue }
    break
  }
  safe-exit ...$args
}
wrapper func x(...args) { xa ...$args }
alias q = xa

alias xevkey = command xev -event keyboard
# The display rides a `VAR=value cmd` prefix, so it reaches xrandr without an
# assignment here outliving the call. Same shape config.nu:1418 uses.
wrapper func xr(...args) { DISPLAY=":0.0" xrandr ...$args }
alias jc = command journalctl --no-hostname
alias sc = command systemctl
alias uc = command systemctl --user

# package management, delegated to the `package` script, which dispatches to
# dnf, yum, or apt-get depending on what's available
alias update = package update
alias search = package search
alias install = package install
alias installed = package installed
alias uninstall = package uninstall
alias reinstall = package reinstall
alias autoremove = package autoremove
alias upgrade = package upgrade
alias versions = package versions
# `info` shadows the GNU program of that name, deliberately and in step with
# the other three shells; `command info` still reaches the reader.
alias info = package info
# No `files` shortcut, unlike shrc:2803, config.fish:1311 and config.nu:1487:
# `files` is one of mesh's six reserved value-call names (re, style, link,
# glob, files, dirs) and cannot be bound. `package files` is the spelling here.
alias listfiles = package listfiles
alias depends = package depends
alias rdepends = package rdepends

# session-manager verbs, named {verb}{backend}: verb is a(uto), c(hange),
# d(etach), or m(ake); backend is s (follow the active backend), sp (shpool),
# or tm (tmux). The change*/detach*/make* scripts live in the scripts repo and
# dispatch on $TMUX/$SHPOOL_SESSION_NAME/$SESSION_BACKEND, so the backend
# session-backend picked (which honors the WANT_* opt-outs the scripts can't
# see) is handed to them explicitly.
alias as = autosession
alias asp = autoshpool
alias atm = autotmux
alias ctm = changetmux
alias dsp = detachshpool
alias dtm = detachtmux
alias mtm = maketmux

# shpool cannot switch a live client itself: changeshpool hands the switch to
# autoshpool's outer loop by detaching us, so the parked shell has to exit.
# Only on the no-arg picker path -- --list/--help also succeed but only print
# -- and only when shpool is the backend that ran, since a tmux session nested
# in shpool switches in place and must stay.
# The backend session-backend picked rides a `VAR=value cmd` prefix, so the
# script sees it without an assignment in this shell outliving the call.
bool func session-script-wanted() {
  return true if inside-tmux()
  return true if in-shpool()
  return session-backend() != ""
}

wrapper func cs(...args) {
  return unless session-script-wanted()
  backend = session-backend()
  SESSION_BACKEND=$backend changesession ...$args
  return unless $sh.status
  return unless $args:len == 0
  return if inside-tmux()
  exit if in-shpool()
}
wrapper func csp(...args) {
  changeshpool ...$args
  return unless $sh.status
  return unless $args:len == 0
  exit if in-shpool()
}
wrapper func ds(...args) {
  return unless session-script-wanted()
  backend = session-backend()
  SESSION_BACKEND=$backend detachsession ...$args
}
wrapper func ms(...args) {
  return unless session-script-wanted()
  backend = session-backend()
  SESSION_BACKEND=$backend makesession ...$args
  return unless $sh.status
  return if inside-tmux()
  exit if in-shpool()
}
wrapper func msp(...args) {
  makeshpool ...$args
  return unless $sh.status
  exit if in-shpool()
}

# clone or cd into a repo, then start a session matching the new root.
# autosession only runs when the underlying command succeeds, so a failed
# clone doesn't spawn a stray session.
wrapper func jd(...args) { jjd ...$args and autosession }
wrapper func hd(...args) { hgd ...$args and autosession }
wrapper func gd(...args) { gitd ...$args and autosession }
wrapper func mjd(...args) { jjd -f ...$args and autosession }
wrapper func mhd(...args) { hgd -f ...$args and autosession }
wrapper func mgd(...args) { gitd -f ...$args and autosession }

# re-read this configuration. Both halves, in the order mesh reads them: PATH,
# GOPATH, brew/fnm and env.local.mesh all live in env.mesh, so sourcing only
# rc.mesh would leave every one of them stale. shrc's `rerc` re-reads a single
# file because shrc *is* a single file.
#
# The second source is gated on the first: a `source` that fails sets the
# status and keeps going, so an env.mesh that no longer parses would be
# followed by an rc.mesh that does, and `rerc` would report success over a
# half-reloaded shell. shrc has no such pair to sequence.
func rerc() {
  source "$env.HOME/.config/mesh/env.mesh"
  status = $sh.status
  if not $status {
    error "rerc: env.mesh failed; the environment is unchanged and rc.mesh was not read"
    fail $status
  }
  source "$env.HOME/.config/mesh/rc.mesh"
}

# Read the interactive local overrides, if any. A named function rather than
# an inline `source` in the section below, by the same rule as
# apply-shpool-initial-pwd: nothing past the interactive gate is reachable from
# a test, so anything with behavior worth asserting has to be defined up here.
bool func read-local-rc() {
  file = "$env.HOME/.config/mesh/rc.local.mesh"
  return unless $file:read
  source $file
  # Reported here for the same reason env.mesh reports its own local file: a
  # file's status is that of its last statement, so the auth gate that follows
  # would overwrite this one and `rerc` would see success. Not fatal either,
  # and for the same reason -- a broken per-machine override shouldn't cost the
  # shell everything already set up before it.
  # Split rather than one `fail $status`, because the success case has to stay
  # on the `return` side: `fail 0` is refused, status being a channel that only
  # carries failure.
  status = $sh.status
  return true if $status
  warn "rc.local.mesh failed; the rest of the interactive setup still ran"
  fail $status
}

#########################
# INTERACTIVE SETUP
# Everything above is definitions, so sourcing this file from a test or a
# script is side-effect free. Everything below acts, and only in a real
# interactive session.

return unless $sh.interactive

apply-shpool-initial-pwd

# Hand off to shpool or tmux before anything else interactive is set up: a
# shell that is about to be replaced should not pay for a prompt it will throw
# away.
maybe-start-session-and-exit

# Past this point we're the shell we're keeping -- the handoff above exits if
# it started a session -- so build the generated aliases here, as shrc and
# config.fish do at the same point. Both run a program, so neither can sit at
# file scope: everything above the interactive marker stays side-effect free so
# the file can be sourced by a test.
#
# vcs first, so a `Host` named after a subcommand cannot take it over. Each
# generator skips a name that is already a function, so whichever runs first
# wins -- and that was the order before, when the vcs shortcuts were file-scope
# definitions and so always in place before the ssh ones were built.
set-up-vcs-aliases
set-up-ssh-aliases

log-history "New session as" $env:get(USERNAME, "") "in mesh"

on preprompt context preprompt
on preexec history command-started
on postexec report command-finished
# Under the `title` name, so these replace the shipped prelude handlers rather
# than fighting them for the window: two handlers on one moment would both run
# and the later registration would win every redraw.
#
# Registered *after* the context hook, and load-bearing: hooks run in
# registration order, so `preprompt` has warmed the session and project names
# by the time title-idle reads them. Swapping these two lines would make the
# title fork for both all over again.
on preprompt title title-idle
on preexec title title-busy
# Last on preexec, so the title above has read the warm values and everything
# after -- the user's command -- sees live ones.
on preexec cache cool-prompt-cache
# Clear the published job file on the way out. shrc traps EXIT and fish uses a
# fish_exit handler for the same reason; config.nu has no exit hook and has to
# leave a stale file behind.
on exit jobs unpublish-jobs
prompt "$ "

# Interactive local overrides (work vs home, etc.), matching shrc's
# ~/.shrc.local and config.fish's local.fish. Anything the session handoff
# above reads -- WANT_SHPOOL, WANT_TMUX, SESSION_BACKEND -- is too late here
# and belongs in env.local.mesh, which env.mesh reads before any of this runs.
read-local-rc

# Gated on a real terminal as well as interactivity: `ssh-add` prompts, and a
# forced-interactive session with stdin redirected (`mesh -i` under nohup, the
# case shrc documents) cannot answer it. config.fish:2044 combines the same two
# predicates.
if stdin-is-tty() and not in-shpool() and need-auth() { auth }
